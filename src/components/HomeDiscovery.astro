---
const discoveries = [
    { title: 'Nyt i Aarhus', text: 'Nye favoritter er landet i byen.', href: '/Produkt-overblik?nyheder=1', cta: 'Se nyhederne', theme: 'new', image: '/images/clothes/Blue_shirt.png', label: 'Nye på HIGHLIDE' },
    { title: 'Under 1.000 kr.', text: 'Plads til et godt fund.', href: '/Produkt-overblik?prisTil=999.99', cta: 'Find din næste favorit', theme: 'budget', image: '/images/clothes/Brown_shoes.png', label: 'Mere stil. Mindre budget.' },
    { title: 'På udsalg', text: 'Din stil. Til en mindre pris.', href: '/Produkt-overblik?udsalg=1', cta: 'Gå på tilbudsjagt', theme: 'sale', image: '/images/clothes/Brown_coat.png', label: 'Gode fund venter' },
];
---
<section id="opdag" class="discovery" aria-labelledby="discovery-title">
    <div class="section-heading"><div><h2 id="discovery-title">Hvad er du på udkig efter?</h2><p>Tag en genvej til dit næste lokale fund.</p></div><a href="/Produkt-overblik">Se alt tøjet <span aria-hidden="true">↗</span></a></div>
    <div class="discovery-grid">
        {discoveries.map((item) => <a href={item.href} class:list={['discovery-tile', item.theme]}>
            <span class="tile-label">{item.label}</span>
            <img src={item.image} alt="" width="384" height="579" loading="lazy" decoding="async" />
            <div class="tile-copy"><h3>{item.title}</h3><p>{item.text}</p><span class="tile-cta">{item.cta}<span class="arrow" aria-hidden="true">↗</span></span></div>
        </a>)}
    </div>
    <p class="image-note">Billederne er stilinspiration. Se aktuelle varer og priser i udvalget.</p>
</section>
<style>
    .discovery {padding:3.5rem 0 0; scroll-margin-top:110px;}
    .section-heading {display:flex; flex-wrap:wrap; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1.6rem;}
    h2 {font-size:clamp(1.9rem,3.2vw,2.6rem); line-height:1.12; font-weight:600; letter-spacing:-.035em; text-wrap:balance;}
    .section-heading p {color:#5c534b; margin-top:.7rem; line-height:1.6;}
    .section-heading>a {display:flex; gap:1.5rem; align-items:center; min-height:44px; font-size:.9rem; font-weight:600; color:#420e0e;}
    .discovery-grid {display:grid; grid-template-columns:1.15fr 1fr 1fr; gap:1rem;}
    .discovery-tile {position:relative; isolation:isolate; overflow:hidden; border-radius:12px; min-height:405px; padding:1.5rem; color:#fff; display:flex; flex-direction:column; justify-content:space-between;}
    .new {background:radial-gradient(ellipse at 90% 10%,#933b47,#420e0e 70%);}
    .budget {background:radial-gradient(ellipse at 85% 10%,#d8c3b0,#eadfd3 70%);color:#420e0e;}
    .sale {background:radial-gradient(ellipse at 70% 20%,#844d4a,#28151c 75%);}
    .tile-label {position:relative;z-index:1;font-size:.75rem;font-weight:600;width:fit-content;}
    .discovery-tile img {position:absolute; z-index:-1; height:300px; width:240px; object-fit:contain; top:-8px; right:-15px; transform:rotate(9deg); transition:transform .35s ease-out;}
    .budget img {height:315px;width:250px;top:-5px;transform:rotate(-12deg);}
    .sale img {height:300px;top:-5px;right:-30px;transform:rotate(12deg);}
    .discovery-tile:before {content:'';position:absolute;inset:0;z-index:0;background:linear-gradient(0deg,#420e0e 0%,#420e0ef0 22%,transparent 68%);}
    .budget:before {background:linear-gradient(0deg,#eadfd3 0%,#eadfd3f0 22%,transparent 68%);}
    .sale:before {background:linear-gradient(0deg,#28151c 0%,#28151cf0 22%,transparent 68%);}
    .tile-copy {position:relative;z-index:1;}
    h3 {font-size:clamp(1.7rem,2.6vw,2.25rem);line-height:1.15;letter-spacing:-.035em;font-weight:600; text-wrap:balance;}
    .tile-copy p {font-size:.875rem;line-height:1.6;margin-top:.65rem;}
    .tile-cta {display:flex;align-items:center;justify-content:space-between;gap:.5rem;font-size:.8rem;font-weight:600;margin-top:1.4rem;}
    .arrow {display:grid;place-items:center;width:40px;height:40px;border:1px solid currentColor;border-radius:50%;font-size:1.25rem;transition:background .2s;}
    .discovery-tile:hover img {transform:rotate(0) scale(1.04);}
    .image-note {font-size:.75rem;color:#62564d;margin-top:.8rem;}
    a:focus-visible {outline:3px solid #a95346;outline-offset:5px;}
    .section-heading>a:hover {text-decoration:underline;text-underline-offset:5px;}
    @media(max-width:767px) {.discovery-grid{grid-template-columns:1fr;}.discovery-tile{min-height:300px;padding:1.4rem;}.discovery-tile img{height:300px;width:230px;right:-8px;top:-25px;}.discovery-tile:before{background:linear-gradient(0deg,#420e0e 0%,#420e0ec9 32%,transparent 90%);}.budget:before{background:linear-gradient(0deg,#eadfd3,#eadfd3b0 40%,transparent 90%);}.sale:before{background:linear-gradient(0deg,#28151c,#28151ccc 40%,transparent 90%);}h3{font-size:2rem;}.tile-cta{margin-top:.7rem;}}

    @media(prefers-reduced-motion:reduce) {.discovery-tile img,.arrow{transition:none;}.discovery-tile:hover img{transform:none;}}
</style>
