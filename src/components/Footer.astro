---
import { siteInfo } from "../lib/siteInfo.js";

const exploreLinks = [
    { href: "/Produkt-overblik", label: "Produkter" },
    { href: "/Butiks-info", label: "Butikker" },
];

const informationLinks = [
    { href: "/Om-Highlide", label: "Om HIGHLIDE" },
    { href: "/Hjaelp", label: "Hjælp" },
    { href: "/Kontakt", label: "Kontakt" },
    { href: "/Privatlivspolitik", label: "Privatlivspolitik" },
];

const socialLinks = [
    {
        href: "https://www.instagram.com/highlide_aarhus/",
        label: "Instagram",
        icon: "instagram",
    },
    {
        href: "https://www.facebook.com/profile.php?id=61587038121539",
        label: "Facebook",
        icon: "facebook",
    },
    {
        href: "https://www.linkedin.com/company/highlide/",
        label: "LinkedIn",
        icon: "linkedin",
    },
];
---

<footer class="mt-10 bg-[#420e0e] text-[#f8f4ec]">
    <div class="mx-auto max-w-[1120px] px-6 py-10 md:px-8 md:py-12">
        <div class="grid gap-10 md:grid-cols-[1.4fr_0.6fr_0.8fr] md:gap-12">
            <div class="max-w-sm">
                <a
                    class="inline-block text-[2.15rem] font-black uppercase leading-none tracking-tight text-white"
                    href="/"
                    aria-label="HIGHLIDE forside"
                >
                    HIGHLIDE
                </a>
                <p class="mt-4 text-sm leading-6 text-white/75">
                    Find tøj fra mindre lokale modebutikker, se lagerstatus og
                    fortsæt ud i Aarhus.
                </p>
                <div
                    class="mt-5 flex items-center gap-2"
                    aria-label="Følg HIGHLIDE"
                >
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noreferrer"
                                aria-label={link.label}
                                class="inline-flex size-11 items-center justify-center rounded-full border border-white/30 text-white transition hover:border-white hover:bg-white hover:text-[#420e0e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#dbeafc] focus-visible:ring-offset-2 focus-visible:ring-offset-[#420e0e]"
                            >
                                {link.icon === "instagram" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="size-[1.15rem]"
                                        fill="none"
                                        aria-hidden="true"
                                    >
                                        <rect
                                            x="4.5"
                                            y="4.5"
                                            width="15"
                                            height="15"
                                            rx="4"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        />
                                        <circle
                                            cx="12"
                                            cy="12"
                                            r="3.5"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        />
                                        <circle
                                            cx="17.2"
                                            cy="6.8"
                                            r="1.1"
                                            fill="currentColor"
                                        />
                                    </svg>
                                )}
                                {link.icon === "facebook" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="size-[1.1rem]"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path d="M13.3 20v-7h2.4l.4-2.8h-2.8V8.4c0-.8.2-1.3 1.4-1.3h1.5V4.6c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v2.2H8.5V13h2.3v7h2.5Z" />
                                    </svg>
                                )}
                                {link.icon === "linkedin" && (
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="size-[1.1rem]"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <path d="M6.4 8.2a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm-1.3 10.6h2.6v-8.2H5.1v8.2Zm4.1 0h2.6v-4.6c0-1.2.2-2.4 1.7-2.4s1.5 1.4 1.5 2.5v4.5h2.6v-5c0-2.4-.5-4.3-3.3-4.3-1.3 0-2.1.7-2.5 1.4h-.1v-1.2H9.2c0 .8 0 1.6 0 2.5v6.6Z" />
                                    </svg>
                                )}
                            </a>
                        ))
                    }
                </div>
            </div>

            <nav aria-label="Udforsk HIGHLIDE">
                <h2 class="text-sm font-semibold text-white">Udforsk</h2>
                <ul class="mt-4 space-y-3 text-sm text-white/75">
                    {
                        exploreLinks.map((link) => (
                            <li>
                                <a
                                    class="transition hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#dbeafc]"
                                    href={link.href}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <nav aria-label="Information om HIGHLIDE">
                <h2 class="text-sm font-semibold text-white">Information</h2>
                <ul
                    class="mt-4 grid grid-cols-2 gap-x-5 gap-y-3 text-sm text-white/75 md:grid-cols-1"
                >
                    {
                        informationLinks.map((link) => (
                            <li>
                                <a
                                    class="transition hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#dbeafc]"
                                    href={link.href}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <div
            class="mt-10 flex flex-col gap-3 border-t border-white/20 pt-5 text-xs leading-5 text-white/65 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
        >
            <p>
                © {new Date().getFullYear()}
                {siteInfo.name} · CVR {siteInfo.cvr}
            </p>
            <address class="not-italic">{siteInfo.address}</address>
            <a
                class="font-medium text-[#f8f4ec] underline-offset-4 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-[#dbeafc]"
                href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a
            >
        </div>
    </div>
</footer>
