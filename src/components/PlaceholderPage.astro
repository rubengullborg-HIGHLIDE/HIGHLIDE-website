---
interface Props {
    eyebrow?: string;
    title: string;
    description: string;
    primaryHref?: string;
    primaryLabel?: string;
}

const {
    eyebrow = "Kommer snart",
    title,
    description,
    primaryHref = "/Produkt-overblik",
    primaryLabel = "Se produkter",
} = Astro.props;
---

<section class="mx-auto flex min-h-[52vh] max-w-2xl flex-col justify-center py-10">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-[#7b6f64]">
        {eyebrow}
    </p>
    <h1
        class="mt-4 text-[2.4rem] font-semibold leading-[1.05] tracking-[-0.04em] text-[#1e1a17] md:text-[3.5rem]"
    >
        {title}
    </h1>
    <p class="mt-5 text-base leading-8 text-[#5c534b] md:text-lg">
        {description}
    </p>
    <a
        href={primaryHref}
        class="mt-8 inline-flex w-fit items-center rounded-full bg-[#420e0e] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#551515]"
    >
        {primaryLabel}
    </a>
</section>
