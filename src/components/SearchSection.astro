---
interface Props {
    heading?: string;
    description?: string;
    placeholder?: string;
    buttonLabel?: string;
    action?: string;
    value?: string;
    compact?: boolean;
    storeFilters?: boolean;
    suggestions?: boolean;
}

import ProductFilters from "./ProductFilters.astro";
import { Picture } from "astro:assets";
import walkingPeople from "../assets/walking-people.webp";

const {
    heading = "Find din stil lokalt",
    description = "Opdag produkter fra mindre lokale modebutikker, og se hvor de er på lager i Aarhus.",
    placeholder = "Hvid t-shirt, blå bukser ...",
    buttonLabel = "Søg",
    action = "",
    value = "",
    compact = false,
    storeFilters = true,
    suggestions = false,
} = Astro.props;
---

{
    compact ? (
        <section class="mx-auto flex w-full max-w-5xl flex-col gap-3 py-4 md:gap-4 md:py-6">
            <form class="w-full" role="search" method="get" action={action}>
                <label class="sr-only" for="product-search">
                    {placeholder}
                </label>
                <div class="flex items-center rounded-full border border-black/15 bg-white p-2 shadow-[0_6px_8px_rgba(53,33,18,0.06)] transition hover:border-[#420E0E] hover:shadow-[0_0_0_3px_rgba(66,14,14,0.12)] focus-within:border-[#420E0E] focus-within:ring-1 focus-within:ring-[#420E0E]">
                    <input
                        id="product-search"
                        name="q"
                        type="search"
                        placeholder={placeholder}
                        value={value}
                        class="min-w-0 flex-1 cursor-text border-0 bg-transparent px-4 py-4 text-[1.05rem] text-[#1e1a17] placeholder:text-[#6f655b] focus:outline-none"
                    />
                    <button
                        type="submit"
                        class="shrink-0 cursor-pointer rounded-full bg-[#420E0E] px-6 py-3 text-base font-medium text-white transition hover:bg-[#551515] focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2"
                    >
                        {buttonLabel}
                    </button>
                </div>
            </form>
            {storeFilters && (
                <ProductFilters action={action} showQuickControls={true} />
            )}
        </section>
    ) : (
        <section class="relative -mx-4 -mt-8 min-h-[34rem] overflow-hidden bg-[#312a25] md:-mx-8 md:min-h-[38rem] lg:mx-0 lg:rounded-b-xl">
            {/* Account for the full image width when object-cover crops the tall hero. */}
            <Picture
                src={walkingPeople}
                formats={['avif', 'webp']}
                widths={[1024, 1280, 1600, 2048]}
                sizes="(min-width: 1184px) 1120px, (min-width: 768px) max(1080px, 100vw), max(967px, 100vw)"
                quality={60}
                alt="Personer foran en lokal modebutik i byen"
                class="absolute inset-0 h-full w-full object-cover object-center"
                fetchpriority="high"
                loading="eager"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(90deg,rgba(22,18,15,0.78)_0%,rgba(22,18,15,0.5)_45%,rgba(22,18,15,0.08)_78%)]"
                aria-hidden="true"
            />
            <div class="relative flex min-h-[34rem] items-center px-5 py-16 md:min-h-[38rem] md:px-12 lg:px-16">
                <div class="w-full max-w-2xl">
                    <h1 class="max-w-xl text-[2.8rem] font-semibold leading-[0.98] tracking-[-0.04em] text-white sm:text-6xl md:text-[4.4rem]">
                        {heading}
                    </h1>
                    <p class="mt-5 max-w-xl text-base leading-7 text-white/90 md:text-lg">
                        {description}
                    </p>
                    <div class="mt-8 flex max-w-2xl items-center gap-2">
                        <form
                            class="min-w-0 flex-1"
                            role="search"
                            method="get"
                            action={action}
                        >
                            <label class="sr-only" for="frontpage-search">
                                {placeholder}
                            </label>
                            <div class="flex items-center rounded-full bg-white p-2 ring-1 ring-black/10 transition hover:ring-2 hover:ring-[#420E0E]/35 focus-within:ring-2 focus-within:ring-[#420E0E]">
                                <input
                                    id="frontpage-search"
                                    name="q"
                                    type="search"
                                    placeholder={placeholder}
                                    value={value}
                                    class="min-w-0 flex-1 cursor-text border-0 bg-transparent px-3 py-3 text-base text-[#1e1a17] placeholder:text-[#6f655b] focus:outline-none sm:px-5"
                                />
                                <button
                                    type="submit"
                                    class="shrink-0 cursor-pointer rounded-full bg-[#420E0E] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#551515] focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2 sm:px-7 sm:text-base"
                                >
                                    {buttonLabel}
                                </button>
                            </div>
                        </form>
                        {storeFilters && <ProductFilters action={action} />}
                    </div>
                    {suggestions && (
                        <nav class="mt-3 flex flex-wrap items-center gap-x-4 text-sm text-white" aria-label="Forslag til din søgning">
                            <span class="text-white/90">Prøv fx</span>
                            {[
                                { label: 'Skjorter', type: 'skjorter' },
                                { label: 'Jakker', type: 'jakker' },
                                { label: 'Strik', type: 'strik' },
                            ].map((item) => (
                                <a href={`${action}?type=${item.type}`} class="inline-flex min-h-11 items-center underline decoration-white/50 underline-offset-4 transition-colors hover:decoration-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white motion-reduce:transition-none">
                                    {item.label}
                                </a>
                            ))}
                        </nav>
                    )}
                </div>
            </div>
        </section>
    )
}
