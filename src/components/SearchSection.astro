---
interface Props {
    heading?: string;
    description?: string;
    placeholder?: string;
    buttonLabel?: string;
    action?: string;
    value?: string;
    compact?: boolean;
    storeFilters?: boolean;
}

import { productSources } from "../lib/productSources.js";

const {
    heading = "Find din stil",
    description =
        "Søg blandt tøj, brands og butikker fra lokale modebutikker i Aarhus.",
    placeholder = "Søg efter tøj...",
    buttonLabel = "Søg",
    action = "",
    value = "",
    compact = false,
    storeFilters = true,
} = Astro.props;
---

<section
    class:list={[
        "mx-auto flex w-full flex-col",
        compact
            ? "max-w-5xl gap-6 py-4 md:py-6"
            : "max-w-3xl items-center gap-8 py-16 text-center md:py-24",
    ]}
>
    {
        !compact && (
            <div class="space-y-3">
                <h1 class="text-5xl font-semibold uppercase tracking-[0.04em] text-[#1e1a17] md:text-6xl">
                    {heading}
                </h1>
                <p class="mx-auto max-w-2xl text-base leading-7 text-[#5c534b] md:text-lg">
                    {description}
                </p>
            </div>
        )
    }

    <div class:list={["w-full", compact ? "max-w-none" : "max-w-2xl"]}>
        <form role="search" method="get" action={action}>
            <input
                type="hidden"
                name="butik"
                data-store-filter-input
                disabled
            />
            <label class="sr-only" for="frontpage-search">{placeholder}</label>
            <div
                class:list={[
                    "flex items-center rounded-full border border-black/15 bg-white p-2 transition focus-within:border-[#420E0E] focus-within:ring-1 focus-within:ring-[#420E0E]",
                    compact && "shadow-[0_12px_30px_rgba(53,33,18,0.08)]",
                ]}
            >
                <input
                    id="frontpage-search"
                    name="q"
                    type="search"
                    placeholder={placeholder}
                    value={value}
                    class:list={[
                        "min-w-0 flex-1 border-0 bg-transparent text-[#1e1a17] placeholder:text-[#8a8178] focus:outline-none",
                        compact ? "px-4 py-4 text-[1.05rem]" : "px-4 py-3 text-base",
                    ]}
                />
                <button
                    type="submit"
                    class="shrink-0 cursor-pointer rounded-full bg-[#420E0E] px-6 py-3 text-base font-medium text-white transition hover:opacity-90"
                >
                    {buttonLabel}
                </button>
            </div>
        </form>

        {
            storeFilters && (
                <nav
                    class="mt-3 flex gap-2 overflow-x-auto pb-1"
                    aria-label="Filtrer efter butik"
                    data-store-filters
                    data-filter-action={action}
                >
                    <a
                        class="store-filter shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2 focus:ring-offset-[#f8f4ec]"
                        href={action}
                        data-store-filter
                        data-store-key="all"
                        data-active="false"
                    >
                        Alle butikker
                    </a>
                    {
                        productSources.map((source) => (
                            <a
                                class="store-filter shrink-0 rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2 focus:ring-offset-[#f8f4ec]"
                                href={`${action}?butik=${encodeURIComponent(source.key)}`}
                                data-store-filter
                                data-store-key={source.key}
                                data-active="false"
                            >
                                {source.storeName}
                            </a>
                        ))
                    }
                </nav>
            )
        }
    </div>
</section>

<script>
    document.querySelectorAll("[data-store-filters]").forEach((filters) => {
        const filterAction = filters.dataset.filterAction || "/Produkt-overblik";
        const links = [...filters.querySelectorAll("[data-store-filter]")];
        const params = new URLSearchParams(window.location.search);
        const requestedStore = params.get("butik");
        const hasRequestedStore = links.some(
            (link) => link.dataset.storeKey === requestedStore,
        );
        const activeStore = hasRequestedStore ? requestedStore : "all";
        const storeInput = filters
            .closest("section")
            ?.querySelector("[data-store-filter-input]");

        if (storeInput) {
            storeInput.disabled = activeStore === "all";
            storeInput.value = activeStore === "all" ? "" : activeStore;
        }

        links.forEach((link) => {
            const storeKey = link.dataset.storeKey || "all";
            const destination = new URL(window.location.href);
            destination.pathname = filterAction;

            if (storeKey === "all") {
                destination.searchParams.delete("butik");
            } else {
                destination.searchParams.set("butik", storeKey);
            }

            link.href = `${destination.pathname}${destination.search}${destination.hash}`;
            link.dataset.active = String(storeKey === activeStore);
            link.toggleAttribute("aria-current", storeKey === activeStore);
        });
    });
</script>

<style>
    .store-filter[data-active="true"] {
        border-color: #420e0e;
        background: #420e0e;
        color: white;
    }

    .store-filter[data-active="false"] {
        border-color: #d6ccc1;
        background: white;
        color: #514840;
    }

    .store-filter[data-active="false"]:hover {
        border-color: #420e0e;
        color: #420e0e;
    }
</style>
