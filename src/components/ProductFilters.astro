---
import {
    clothingTypeOptions,
    defaultProductSort,
    productFilterParams,
    productSortOptions,
} from "../lib/productFilters.js";
import { productSources } from "../lib/productSources.js";

interface Props {
    action?: string;
    showQuickControls?: boolean;
}

const { action = "/Produkt-overblik", showQuickControls = false } = Astro.props;

const staticSections = [
    {
        key: "stores",
        label: "Butik",
        name: productFilterParams.stores,
        options: productSources.map((source) => ({
            value: source.key,
            label: source.storeName,
        })),
    },
    {
        key: "types",
        label: "Kategori",
        name: productFilterParams.types,
        options: clothingTypeOptions,
    },
];

const dynamicSections = [
    {
        key: "brands",
        label: "Brand",
        name: productFilterParams.brands,
        searchable: true,
    },
    {
        key: "colors",
        label: "Farve",
        name: productFilterParams.colors,
        searchable: false,
        note: "Kun produkter med en angivet farvegruppe vises, når du vælger en farve.",
    },
];
---

<div class:list={["shrink-0 text-left", showQuickControls && "w-full"]} data-product-filters data-filter-action={action}>
    <div class:list={[showQuickControls && "filter-toolbar flex items-center gap-0 overflow-x-auto py-1 sm:gap-1"]}>
        <button
            type="button"
            class:list={[
                "filter-tool inline-flex h-11 shrink-0 items-center gap-1.5 rounded-lg px-3 text-[0.82rem] font-medium text-[#1e1a17] transition focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#420e0e] sm:gap-2 sm:px-3.5 sm:text-sm",
                showQuickControls
                    ? "bg-black/[0.045] hover:bg-black/[0.075] active:bg-black/10"
                    : "border border-[#d6ccc1] bg-white hover:border-[#420e0e] active:bg-[#f5efe8]",
            ]}
            data-filter-open
            aria-haspopup="dialog"
        >
            <span aria-hidden="true" class="filter-glyph"><i></i><i></i><i></i></span>
            Filtre
            <span
                class="hidden min-w-5 rounded-full bg-[#420e0e] px-1.5 py-0.5 text-center text-xs font-semibold leading-4 text-white"
                data-filter-badge
            ></span>
        </button>

        {showQuickControls && (
            <>
                <button
                    type="button"
                    class="quick-filter-control inline-flex h-11 shrink-0 items-center gap-1 rounded-lg px-2.5 text-[0.82rem] font-medium text-[#443b35] transition hover:bg-black/[0.055] active:bg-black/[0.085] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#420e0e] sm:gap-1.5 sm:px-3 sm:text-sm"
                    data-quick-filter={productFilterParams.newProducts}
                    aria-pressed="false"
                >
                    <svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true">
                        <path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        <circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    Nyheder
                </button>
                <button
                    type="button"
                    class="quick-filter-control inline-flex h-11 shrink-0 items-center gap-1 rounded-lg px-2.5 text-[0.82rem] font-medium text-[#443b35] transition hover:bg-black/[0.055] active:bg-black/[0.085] focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#420e0e] sm:gap-1.5 sm:px-3 sm:text-sm"
                    data-quick-filter={productFilterParams.onSale}
                    aria-pressed="false"
                >
                    <span class="text-[0.9rem] font-semibold" aria-hidden="true">%</span>
                    Udsalg
                </button>
                <label class="quick-sort-control relative inline-flex h-11 shrink-0 cursor-pointer items-center gap-1 rounded-lg px-2.5 text-[0.82rem] font-medium text-[#443b35] transition hover:bg-black/[0.055] focus-within:ring-2 focus-within:ring-inset focus-within:ring-[#420e0e] sm:gap-1.5 sm:px-3 sm:text-sm">
                    <svg viewBox="0 0 20 20" fill="none" class="size-4" aria-hidden="true">
                        <path d="M5 4v12M5 16l-2.5-2.5M5 16l2.5-2.5M15 16V4M15 4l-2.5 2.5M15 4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span data-quick-sort-copy>Sortér</span>
                    <select
                        class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
                        aria-label="Sortér produkter"
                        data-quick-sort
                    >
                        {productSortOptions.map((option) => (
                            <option value={option.value}>{option.label}</option>
                        ))}
                    </select>
                </label>
            </>
        )}
    </div>

    {showQuickControls && (
        <div class="hidden pt-2" data-page-active-summary aria-live="polite">
            <div class="flex items-center justify-between gap-4">
                <p class="text-xs font-semibold text-[#5c534b]" data-page-active-heading>Aktive filtre</p>
                <button
                    type="button"
                    class="min-h-9 shrink-0 text-xs font-semibold text-[#420e0e] underline decoration-[#420e0e]/35 underline-offset-4 transition hover:decoration-[#420e0e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#420e0e]"
                    data-page-filter-clear
                >
                    Ryd alle
                </button>
            </div>
            <div class="mt-1.5 flex flex-wrap gap-1.5" data-active-filter-list></div>
        </div>
    )}

    <dialog
        class="filter-dialog m-0 h-auto max-h-[92dvh] w-full max-w-none overflow-hidden border-0 bg-white p-0 text-[#1e1a17] backdrop:bg-black/45 md:m-auto md:max-h-[85dvh] md:w-[36rem] md:rounded-2xl"
        data-filter-dialog
        aria-labelledby="product-filter-title"
    >
        <form class="flex h-full max-h-[92dvh] flex-col md:max-h-[85dvh]" data-filter-form>
            <header class="sticky top-0 z-10 border-b border-[#e3dbd3] bg-white px-5 py-4 md:px-6 md:py-5">
                <div class="flex min-h-11 items-center justify-between gap-4">
                    <h2 id="product-filter-title" class="text-xl font-semibold">Filtrér produkter</h2>
                    <button
                        type="button"
                        class="grid size-11 place-items-center rounded-full text-2xl leading-none text-[#1e1a17] transition hover:bg-[#f8f4ec] focus:outline-none focus:ring-2 focus:ring-[#420e0e]"
                        data-filter-close
                        aria-label="Luk filtre"
                    >
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
            </header>

            <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-5 md:px-6" data-filter-scroll>
                <div class="hidden border-b border-[#e3dbd3] py-4" data-modal-active-summary aria-live="polite">
                    <div class="flex items-center justify-between gap-4">
                        <p class="text-sm font-semibold text-[#1e1a17]">Valgte filtre</p>
                        <span class="text-xs font-medium text-[#6e645d]" data-modal-active-count></span>
                    </div>
                    <div class="mt-2 flex flex-wrap gap-1.5" data-active-filter-list></div>
                </div>
                {
                    staticSections.map((section) => (
                        <details
                            class="filter-section border-b border-[#e3dbd3]"
                            data-filter-section
                        >
                            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-[#420e0e]">
                                <span>{section.label}</span>
                                <span class="flex items-center gap-3">
                                    <span class="text-sm font-normal text-[#6e645d]" data-section-count={section.name} />
                                    <span class="accordion-mark text-xl font-light" aria-hidden="true">+</span>
                                </span>
                            </summary>
                            <div class="grid gap-1 pb-5">
                                {section.options.map((option) => (
                                    <label class="filter-option flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-2 text-sm transition hover:bg-[#f8f4ec]">
                                        <input
                                            class="filter-checkbox size-5 shrink-0 appearance-none rounded border border-[#a99e94] bg-white"
                                            type="checkbox"
                                            name={section.name}
                                            value={option.value}
                                        />
                                        <span>{option.label}</span>
                                    </label>
                                ))}
                            </div>
                        </details>
                    ))
                }

                {
                    dynamicSections.map((section) => (
                        <details class="filter-section border-b border-[#e3dbd3]" data-filter-section>
                            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-[#420e0e]">
                                <span>{section.label}</span>
                                <span class="flex items-center gap-3">
                                    <span class="text-sm font-normal text-[#6e645d]" data-section-count={section.name} />
                                    <span class="accordion-mark text-xl font-light" aria-hidden="true">+</span>
                                </span>
                            </summary>
                            <div class="pb-5">
                                {section.note && <p class="mb-3 text-xs leading-5 text-[#6e645d]">{section.note}</p>}
                                {section.searchable && (
                                    <label class="mb-3 block">
                                        <span class="sr-only">Søg i {section.label.toLowerCase()}</span>
                                        <input
                                            type="search"
                                            class="min-h-11 w-full rounded-lg border border-[#d6ccc1] bg-white px-3 text-sm outline-none placeholder:text-[#8d837b] focus:border-[#420e0e] focus:ring-1 focus:ring-[#420e0e]"
                                            placeholder={`Søg i ${section.label.toLowerCase()}`}
                                            data-option-search={section.key}
                                        />
                                    </label>
                                )}
                                <div class="grid gap-1" data-dynamic-options={section.key} data-input-name={section.name}>
                                    <p class="py-3 text-sm text-[#6e645d]" data-options-loading>Henter valgmuligheder...</p>
                                </div>
                            </div>
                        </details>
                    ))
                }

                <details class="filter-section border-b border-[#e3dbd3]" data-filter-section>
                    <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 font-medium focus:outline-none focus-visible:ring-2 focus-visible:ring-[#420e0e]">
                        <span>Pris</span>
                        <span class="flex items-center gap-3">
                            <span class="text-sm font-normal text-[#6e645d]" data-section-count="price" />
                            <span class="accordion-mark text-xl font-light" aria-hidden="true">+</span>
                        </span>
                    </summary>
                    <div class="pb-6">
                        <div class="flex items-center justify-between gap-4 text-sm">
                            <span class="font-medium text-[#171411]">Pris op til</span>
                            <output class="font-semibold text-[#420e0e]" data-price-output>Alle priser</output>
                        </div>
                        <input
                            class="price-slider mt-5 h-2 w-full cursor-pointer appearance-none rounded-full bg-[#e4dbd3]"
                            type="range"
                            min="0"
                            max="5000"
                            step="50"
                            value="5000"
                            aria-label="Maksimal pris"
                            data-price-range
                        />
                        <input type="hidden" name={productFilterParams.maxPrice} data-price-value />
                        <div class="mt-3 flex justify-between text-xs text-[#6e645d]">
                            <span>0 kr.</span>
                            <span>5.000+ kr.</span>
                        </div>
                    </div>
                </details>

                <div class="border-b border-[#e3dbd3] py-5">
                    <p class="mb-3 text-sm font-semibold text-[#1e1a17]">Hurtigfiltre</p>
                    <div class="grid gap-2 sm:grid-cols-2">
                        <label class="filter-quick-choice grid min-h-[4.5rem] cursor-pointer grid-cols-[2rem_1fr_1.25rem] items-center gap-3 rounded-lg bg-[#f5f0ea] px-3 py-2.5 text-sm transition hover:bg-[#eee6dd]">
                            <input
                                class="peer sr-only"
                                type="checkbox"
                                name={productFilterParams.newProducts}
                                value="true"
                                data-new-products-filter
                            />
                            <span class="filter-quick-icon grid size-8 place-items-center rounded-md bg-white text-[#420e0e]" aria-hidden="true">
                                <svg viewBox="0 0 20 20" fill="none" class="size-4">
                                    <path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                    <circle cx="10" cy="10" r="3" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                            </span>
                            <span class="filter-quick-copy min-w-0">
                                <span class="block font-medium">Nyheder</span>
                                <span class="mt-0.5 block text-xs leading-4 opacity-65">Tilføjet de seneste 14 dage</span>
                            </span>
                            <span class="filter-quick-check grid size-5 place-items-center rounded-full border border-[#b8aca2] text-xs text-transparent" aria-hidden="true">✓</span>
                        </label>
                        <label class="filter-quick-choice grid min-h-[4.5rem] cursor-pointer grid-cols-[2rem_1fr_1.25rem] items-center gap-3 rounded-lg bg-[#f5f0ea] px-3 py-2.5 text-sm transition hover:bg-[#eee6dd]">
                            <input
                                class="peer sr-only"
                                type="checkbox"
                                name={productFilterParams.onSale}
                                value="true"
                                data-sale-filter
                            />
                            <span class="filter-quick-icon grid size-8 place-items-center rounded-md bg-white text-sm font-semibold text-[#420e0e]" aria-hidden="true">%</span>
                            <span class="filter-quick-copy min-w-0">
                                <span class="block font-medium">Udsalg</span>
                                <span class="mt-0.5 block text-xs leading-4 opacity-65">Kun produkter med nedsat pris</span>
                            </span>
                            <span class="filter-quick-check grid size-5 place-items-center rounded-full border border-[#b8aca2] text-xs text-transparent" aria-hidden="true">✓</span>
                        </label>
                    </div>
                    <label class="relative mt-4 block min-w-0">
                        <span class="pointer-events-none absolute left-3 top-1.5 z-[1] text-[0.65rem] leading-3 text-[#6e645d]">Sortér efter</span>
                        <select
                            class="h-12 w-full appearance-none rounded-lg border border-[#d6ccc1] bg-white pb-1 pl-3 pr-8 pt-4 text-sm font-medium text-[#1e1a17] outline-none transition hover:border-[#420e0e] focus:border-[#420e0e] focus:ring-1 focus:ring-[#420e0e]"
                            name={productFilterParams.sort}
                            aria-label="Sortér efter"
                            data-sort-select
                        >
                            {
                                productSortOptions.map((option) => (
                                    <option value={option.value} selected={option.value === defaultProductSort}>
                                        {option.label}
                                    </option>
                                ))
                            }
                        </select>
                        <span class="pointer-events-none absolute bottom-3 right-3 text-sm leading-none text-[#6e645d]" aria-hidden="true">⌄</span>
                    </label>
                </div>
            </div>

            <footer class="sticky bottom-0 z-10 flex items-center gap-3 border-t border-[#e3dbd3] bg-white px-5 py-4 md:px-6">
                <button
                    type="button"
                    class="min-h-11 shrink-0 px-2 text-sm font-medium text-[#420e0e] underline-offset-4 hover:underline focus:outline-none focus:ring-2 focus:ring-[#420e0e]"
                    data-filter-clear
                >
                    Ryd alle
                </button>
                <button
                    type="submit"
                    class="min-h-12 flex-1 rounded-full bg-[#420e0e] px-5 text-sm font-semibold text-white transition hover:bg-[#561313] disabled:cursor-wait disabled:opacity-70 focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2"
                    data-filter-apply
                >
                    Vis produkter
                </button>
            </footer>
        </form>
    </dialog>
</div>

<script>
    import {
        applyProductFilters,
        getActiveFilterCount,
        getProductSourcesForFilters,
        parseProductFilters,
        productFilterParamNames,
        productFilterParams,
        clothingTypeOptions,
        defaultProductSort,
        productSortOptions,
    } from "../lib/productFilters.js";
    import {
        productSources,
    } from "../lib/productSources.js";
    import {
        getRankedProductSearchCount,
        getRankedProductSearchParams,
    } from "../lib/rankedProductSearch.js";
    import { supabase } from "../lib/supabaseClient.js";

    const filterRoots = document.querySelectorAll("[data-product-filters]");
    const facetColumns = "id, brand, color_group";
    const storeLabels = new Map(
        productSources.map((source) => [source.key, source.storeName]),
    );
    const typeLabels = new Map(
        clothingTypeOptions.map((option) => [option.value, option.label]),
    );
    const sortLabels = new Map(
        productSortOptions.map((option) => [option.value, option.label]),
    );
    const priceFormatter = new Intl.NumberFormat("da-DK");
    let facetPromise;

    const fetchAllRows = async (source) => {
        const rows = [];
        const pageSize = 1000;

        for (let from = 0; ; from += pageSize) {
            let query = supabase
                .from(source.table)
                .select(facetColumns)
                .order(source.orderColumn, { ascending: true })
                .range(from, from + pageSize - 1);
            query = source.applyAvailableFilter(query);

            const { data, error } = await query;
            if (error) throw error;
            rows.push(...(data ?? []));
            if ((data?.length ?? 0) < pageSize) break;
        }

        return rows;
    };

    const getFacetValues = () => {
        facetPromise ??= Promise.all(productSources.map(fetchAllRows)).then(
            (sourceRows) => {
                const rows = sourceRows.flat();
                const unique = (values) =>
                    [...new Set(values.filter((value) => typeof value === "string" && value.trim()))]
                        .sort((a, b) => a.localeCompare(b, "da", { sensitivity: "base" }));

                return {
                    brands: unique(rows.map((row) => row.brand)),
                    colors: unique(rows.map((row) => row.color_group)),
                };
            },
        );

        return facetPromise;
    };

    filterRoots.forEach((root) => {
        const dialog = root.querySelector("[data-filter-dialog]");
        const form = root.querySelector("[data-filter-form]");
        const openButton = root.querySelector("[data-filter-open]");
        const closeButton = root.querySelector("[data-filter-close]");
        const clearButton = root.querySelector("[data-filter-clear]");
        const pageClearButton = root.querySelector("[data-page-filter-clear]");
        const applyButton = root.querySelector("[data-filter-apply]");
        const badge = root.querySelector("[data-filter-badge]");
        const priceRange = root.querySelector("[data-price-range]");
        const priceValue = root.querySelector("[data-price-value]");
        const priceOutput = root.querySelector("[data-price-output]");
        const saleFilter = root.querySelector("[data-sale-filter]");
        const newProductsFilter = root.querySelector("[data-new-products-filter]");
        const sortSelect = root.querySelector("[data-sort-select]");
        const quickFilterButtons = [
            ...root.querySelectorAll("[data-quick-filter]"),
        ];
        const quickSort = root.querySelector("[data-quick-sort]");
        const quickSortControl = root.querySelector(".quick-sort-control");
        const quickSortCopy = root.querySelector("[data-quick-sort-copy]");
        const pageActiveSummary = root.querySelector("[data-page-active-summary]");
        const modalActiveSummary = root.querySelector("[data-modal-active-summary]");
        const modalActiveCount = root.querySelector("[data-modal-active-count]");
        const activeFilterLists = [
            ...root.querySelectorAll("[data-active-filter-list]"),
        ];
        const action = root.dataset.filterAction || "/Produkt-overblik";
        const searchForm = root.closest("section")?.querySelector('form[role="search"]');
        const searchInput = searchForm?.querySelector('input[name="q"]');
        let countTimer;
        let countRequest = 0;
        let facetsLoaded = false;

        const getFormFilters = () => {
            const data = new FormData(form);
            return parseProductFilters(new URLSearchParams(data));
        };

        const getActiveFilterLabels = (filters) => {
            const labels = [
                ...filters.stores.map(
                    (value) => `Butik · ${storeLabels.get(value) ?? value}`,
                ),
                ...filters.types.map(
                    (value) => `Kategori · ${typeLabels.get(value) ?? value}`,
                ),
                ...filters.brands.map((value) => `Brand · ${value}`),
                ...filters.colors.map((value) => `Farve · ${value}`),
                ...filters.fits.map((value) => `Pasform · ${value}`),
            ];

            if (filters.minPrice != null) {
                labels.push(`Fra ${priceFormatter.format(filters.minPrice)} kr.`);
            }
            if (filters.maxPrice != null) {
                labels.push(`Op til ${priceFormatter.format(filters.maxPrice)} kr.`);
            }
            if (filters.newProducts) labels.push("Nyheder");
            if (filters.onSale) labels.push("Udsalg");
            if (filters.sort !== defaultProductSort) {
                labels.push(`Sortering · ${sortLabels.get(filters.sort) ?? filters.sort}`);
            }

            return labels;
        };

        const renderActiveFilters = (filters) => {
            const labels = getActiveFilterLabels(filters);
            activeFilterLists.forEach((list) => {
                list.replaceChildren(
                    ...labels.map((label) => {
                        const chip = document.createElement("span");
                        chip.className = "active-filter-chip";
                        chip.textContent = label;
                        return chip;
                    }),
                );
            });

            pageActiveSummary?.classList.toggle("hidden", labels.length === 0);
            modalActiveSummary?.classList.toggle("hidden", labels.length === 0);
            if (modalActiveCount) {
                modalActiveCount.textContent = `${labels.length} ${labels.length === 1 ? "aktivt" : "aktive"}`;
            }
        };

        const setCheckbox = (name, value, checked) => {
            const input = [...form.querySelectorAll(`input[name="${name}"]`)].find(
                (candidate) => candidate.value === value,
            );
            if (input) input.checked = checked;
        };

        const syncPriceSlider = () => {
            if (!priceRange || !priceValue || !priceOutput) return;

            const max = Number(priceRange.max);
            const value = Number(priceRange.value);
            const hasLimit = Number.isFinite(value) && value < max;
            priceValue.value = hasLimit ? String(value) : "";
            priceOutput.textContent = hasLimit
                ? `${new Intl.NumberFormat("da-DK").format(value)} kr.`
                : "Alle priser";
        };

        const restoreFromUrl = () => {
            form.reset();
            const filters = parseProductFilters(new URL(window.location.href).searchParams);
            Object.entries({
                [productFilterParams.stores]: filters.stores,
                [productFilterParams.types]: filters.types,
                [productFilterParams.brands]: filters.brands,
                [productFilterParams.colors]: filters.colors,
                [productFilterParams.fits]: filters.fits,
            }).forEach(([name, values]) =>
                values.forEach((value) => setCheckbox(name, value, true)),
            );

            if (saleFilter) saleFilter.checked = filters.onSale;
            if (newProductsFilter) newProductsFilter.checked = filters.newProducts;
            if (sortSelect) sortSelect.value = filters.sort;

            const minPrice = form.elements.namedItem(productFilterParams.minPrice);
            const maxPrice = form.elements.namedItem(productFilterParams.maxPrice);
            if (minPrice) minPrice.value = filters.minPrice ?? "";
            if (maxPrice) maxPrice.value = filters.maxPrice ?? "";
            if (priceRange) {
                const sliderMax = Number(priceRange.max);
                const restoredMax = filters.maxPrice ?? sliderMax;
                priceRange.value = String(Math.min(sliderMax, Math.max(0, restoredMax)));
            }
            syncPriceSlider();
            updateUi();
            renderActiveFilters(filters);
        };

        const renderDynamicOptions = async () => {
            if (facetsLoaded) return;

            try {
                const facets = await getFacetValues();
                Object.entries(facets).forEach(([key, values]) => {
                    const container = form.querySelector(`[data-dynamic-options="${key}"]`);
                    const inputName = container?.dataset.inputName;
                    if (!container || !inputName) return;
                    container.innerHTML = "";

                    values.forEach((value) => {
                        const label = document.createElement("label");
                        label.className = "filter-option flex min-h-11 cursor-pointer items-center gap-3 rounded-lg px-2 text-sm transition hover:bg-[#f8f4ec]";
                        label.dataset.optionText = value.toLocaleLowerCase("da");

                        const input = document.createElement("input");
                        input.type = "checkbox";
                        input.name = inputName;
                        input.value = value;
                        input.className = "filter-checkbox size-5 shrink-0 appearance-none rounded border border-[#a99e94] bg-white";

                        const text = document.createElement("span");
                        text.textContent = value.replace(/\s+/g, " ").trim();
                        label.append(input, text);
                        container.append(label);
                    });
                });
                facetsLoaded = true;
                restoreFromUrl();
            } catch (error) {
                console.error("Kunne ikke hente filtermuligheder", error);
                form.querySelectorAll("[data-dynamic-options]").forEach((container) => {
                    container.innerHTML = '<p class="py-3 text-sm text-[#6e645d]">Valgmulighederne kunne ikke hentes.</p>';
                });
            }
        };

        const updateUi = () => {
            const filters = getFormFilters();
            const selectedByName = new Map();
            form.querySelectorAll('input[type="checkbox"]:checked').forEach((input) => {
                selectedByName.set(input.name, (selectedByName.get(input.name) ?? 0) + 1);
            });

            form.querySelectorAll("[data-section-count]").forEach((element) => {
                const key = element.dataset.sectionCount;
                const count = key === "price"
                    ? Number(filters.minPrice != null) + Number(filters.maxPrice != null)
                    : selectedByName.get(key) ?? 0;
                element.textContent = count > 0 ? `${count} valgt` : "";
                element
                    .closest("[data-filter-section]")
                    ?.toggleAttribute("data-active", count > 0);
            });
            renderActiveFilters(filters);
        };

        const updateBadge = () => {
            const filters = parseProductFilters(
                new URL(window.location.href).searchParams,
            );
            const count = getActiveFilterCount(filters);
            badge.textContent = String(count);
            badge.classList.toggle("hidden", count === 0);
            openButton.toggleAttribute("data-active", count > 0);

            quickFilterButtons.forEach((button) => {
                const active =
                    button.dataset.quickFilter === productFilterParams.newProducts
                        ? filters.newProducts
                        : filters.onSale;
                button.setAttribute("aria-pressed", String(active));
            });

            if (quickSort) quickSort.value = filters.sort;
            if (quickSortControl) {
                quickSortControl.toggleAttribute(
                    "data-active",
                    filters.sort !== defaultProductSort,
                );
            }
            if (quickSortCopy) {
                quickSortCopy.textContent =
                    {
                        "price-asc": "Pris ↑",
                        "price-desc": "Pris ↓",
                        "name-asc": "Navn A–Å",
                        "brand-asc": "Brand A–Å",
                    }[filters.sort] ?? "Sortér";
            }
            renderActiveFilters(filters);
        };

        const updateResultCount = async () => {
            const requestId = ++countRequest;
            const filters = getFormFilters();
            const sources = getProductSourcesForFilters(productSources, filters);
            const query = searchInput?.value.trim() ?? "";
            applyButton.disabled = true;
            applyButton.textContent = "Tæller produkter...";

            try {
                if (query) {
                    const { data, error } = await supabase.rpc(
                        "search_products_ranked",
                        getRankedProductSearchParams({
                            searchQuery: query,
                            filters,
                            limit: 1,
                        }),
                    );
                    if (error) throw error;
                    if (requestId !== countRequest) return;

                    const total = getRankedProductSearchCount(data);
                    applyButton.textContent = `Vis ${total} ${total === 1 ? "produkt" : "produkter"}`;
                    return;
                }

                const counts = await Promise.all(
                    sources.map(async (source) => {
                        let countQuery = supabase
                            .from(source.table)
                            .select("id", { count: "exact", head: true });
                        countQuery = source.applyAvailableFilter(countQuery);
                        countQuery = applyProductFilters(countQuery, filters);
                        const { count, error } = await countQuery;
                        if (error) throw error;
                        return count ?? 0;
                    }),
                );
                if (requestId !== countRequest) return;
                const total = counts.reduce((sum, count) => sum + count, 0);
                applyButton.textContent = `Vis ${total} ${total === 1 ? "produkt" : "produkter"}`;
            } catch (error) {
                console.error("Kunne ikke tælle filtrerede produkter", error);
                if (requestId === countRequest) applyButton.textContent = "Vis produkter";
            } finally {
                if (requestId === countRequest) applyButton.disabled = false;
            }
        };

        const scheduleCount = () => {
            window.clearTimeout(countTimer);
            countTimer = window.setTimeout(updateResultCount, 250);
        };

        const openFirstActiveSection = () => {
            if (form.querySelector("[data-filter-section][open]")) return;
            const activeSection = form.querySelector(
                "[data-filter-section][data-active]",
            );
            if (activeSection) activeSection.open = true;
        };

        const openDialog = async () => {
            restoreFromUrl();
            form.querySelectorAll("[data-filter-section]").forEach((section) => {
                section.open = false;
            });
            dialog.showModal();
            document.documentElement.classList.add("filter-dialog-open");
            await renderDynamicOptions();
            openFirstActiveSection();
            scheduleCount();
        };

        openButton?.addEventListener("click", openDialog);
        quickFilterButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const destination = new URL(window.location.href);
                const parameter = button.dataset.quickFilter;
                if (!parameter) return;

                const isActive = button.getAttribute("aria-pressed") === "true";
                destination.pathname = action;
                destination.searchParams.delete("page");
                if (isActive) destination.searchParams.delete(parameter);
                else destination.searchParams.set(parameter, "true");
                window.posthog?.capture("product_quick_filter_toggled", {
                    filter: parameter,
                    enabled: !isActive,
                });
                window.location.assign(`${destination.pathname}${destination.search}`);
            });
        });
        quickSort?.addEventListener("change", () => {
            const destination = new URL(window.location.href);
            destination.pathname = action;
            destination.searchParams.delete("page");
            if (quickSort.value === defaultProductSort) {
                destination.searchParams.delete(productFilterParams.sort);
            } else {
                destination.searchParams.set(
                    productFilterParams.sort,
                    quickSort.value,
                );
            }
            window.posthog?.capture("product_sort_changed", {
                sort: quickSort.value,
            });
            window.location.assign(`${destination.pathname}${destination.search}`);
        });
        closeButton?.addEventListener("click", () => dialog.close());
        clearButton?.addEventListener("click", () => {
            form.reset();
            syncPriceSlider();
            updateUi();
            scheduleCount();
        });
        pageClearButton?.addEventListener("click", () => {
            const destination = new URL(window.location.href);
            destination.pathname = action;
            destination.searchParams.delete("page");
            productFilterParamNames.forEach((name) =>
                destination.searchParams.delete(name),
            );
            window.posthog?.capture("product_filters_cleared", {
                surface: "overview_toolbar",
            });
            window.location.assign(`${destination.pathname}${destination.search}`);
        });

        dialog?.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
        dialog?.addEventListener("close", () => {
            document.documentElement.classList.remove("filter-dialog-open");
        });

        form?.querySelectorAll("[data-filter-section]").forEach((section) => {
            section.addEventListener("toggle", () => {
                if (!section.open) return;
                form.querySelectorAll("[data-filter-section]").forEach((other) => {
                    if (other !== section) other.open = false;
                });
            });
        });

        form?.querySelectorAll("[data-option-search]").forEach((input) => {
            input.addEventListener("input", () => {
                const container = form.querySelector(`[data-dynamic-options="${input.dataset.optionSearch}"]`);
                const term = input.value.trim().toLocaleLowerCase("da");
                container?.querySelectorAll("[data-option-text]").forEach((option) => {
                    option.hidden = Boolean(term) && !option.dataset.optionText.includes(term);
                });
            });
        });

        form?.addEventListener("change", () => {
            syncPriceSlider();
            updateUi();
            scheduleCount();
        });
        priceRange?.addEventListener("input", () => {
            syncPriceSlider();
            updateUi();
            scheduleCount();
        });

        form?.addEventListener("submit", (event) => {
            event.preventDefault();
            const destination = new URL(window.location.href);
            destination.pathname = action;
            destination.searchParams.delete("page");
            productFilterParamNames.forEach((name) => destination.searchParams.delete(name));

            const data = new FormData(form);
            productFilterParamNames.forEach((name) => {
                data.getAll(name).forEach((value) => {
                    const cleanValue = String(value).trim();
                    if (name === productFilterParams.sort && cleanValue === defaultProductSort) {
                        return;
                    }
                    if (cleanValue) destination.searchParams.append(name, cleanValue);
                });
            });

            const query = searchInput?.value.trim() ?? "";
            const filters = getFormFilters();
            window.posthog?.capture("product_filters_applied", {
                active_filter_count: getActiveFilterCount(filters),
                has_search_query: Boolean(query),
                sort: filters.sort,
            });
            if (query) destination.searchParams.set("q", query);
            else destination.searchParams.delete("q");
            window.location.assign(`${destination.pathname}${destination.search}`);
        });

        window.addEventListener("popstate", () => {
            restoreFromUrl();
            updateBadge();
        });

        searchForm?.addEventListener("submit", () => {
            productFilterParamNames.forEach((name) => {
                searchForm.querySelectorAll(`input[data-preserved-filter][name="${name}"]`).forEach((input) => input.remove());
            });
            const currentParams = new URL(window.location.href).searchParams;
            productFilterParamNames.forEach((name) => {
                currentParams.getAll(name).forEach((value) => {
                    const hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.name = name;
                    hidden.value = value;
                    hidden.dataset.preservedFilter = "";
                    searchForm.append(hidden);
                });
            });
        });

        updateBadge();
    });
</script>

