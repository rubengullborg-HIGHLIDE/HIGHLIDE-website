---
import "../styles/global.css";

const movement = [
    {
        product: "Boss Orange T-shirt",
        category: "T-shirts · Herre",
        change: "−12 stk.",
        store: "Bruuns Galleri",
        pace: "Høj",
    },
    {
        product: "Selected Homme overshirt",
        category: "Skjorter · Herre",
        change: "−8 stk.",
        store: "Regina",
        pace: "Høj",
    },
    {
        product: "Matinique chino",
        category: "Bukser · Herre",
        change: "−6 stk.",
        store: "Bruuns Galleri",
        pace: "Stabil",
    },
    {
        product: "BOSS Orange polo",
        category: "Poloer · Herre",
        change: "−5 stk.",
        store: "Regina",
        pace: "Stabil",
    },
];

const stockByStore = [
    { name: "Bruuns Galleri", stock: 742, share: 49, change: "−34" },
    { name: "Regina", stock: 518, share: 34, change: "−21" },
    { name: "Storcenter Nord", stock: 251, share: 17, change: "−7" },
];
---

<!doctype html>
<html lang="da">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <meta name="description" content="Internt HIGHLIDE dashboard." />
        <title>Inventory intelligence · HIGHLIDE</title>
    </head>
    <body class="min-h-screen bg-[#f5f6f3] font-sans text-[#17201d]">
        <header class="border-b border-[#dce1dc] bg-[#fbfcfa]">
            <div class="mx-auto flex min-h-16 max-w-[1280px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
                <a href="/" class="text-lg font-black tracking-[-0.05em] text-[#17201d]">HIGHLIDE</a>
                <div class="flex items-center gap-2 text-xs font-medium text-[#54605a]">
                    <span class="h-2 w-2 rounded-full bg-[#3b7d60]"></span>
                    Internt miljø
                </div>
            </div>
        </header>

        <main class="mx-auto max-w-[1280px] px-4 py-6 sm:px-6 lg:px-8 lg:py-9">
            <div class="flex flex-col gap-5 border-b border-[#dce1dc] pb-6 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <a href="/" class="inline-flex items-center gap-1 text-sm font-medium text-[#54605a] transition hover:text-[#17201d]">
                        <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" aria-hidden="true"><path d="M11.75 4.5 6.25 10l5.5 5.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        HIGHLIDE
                    </a>
                    <div class="mt-4 flex items-center gap-3">
                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#262f2a] text-sm font-bold text-white">K</span>
                        <div>
                            <h1 class="text-2xl font-semibold tracking-[-0.035em] text-[#17201d] sm:text-3xl">Kaufmann · Aarhus</h1>
                            <p class="mt-1 text-sm text-[#637069]">Lager- og prissignaler på tværs af tre butikker</p>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <div class="inline-flex rounded-lg border border-[#d4dad5] bg-white p-1" aria-label="Vælg periode" role="group">
                        <button class="dashboard-period min-h-9 rounded-md bg-[#253b30] px-3 text-sm font-semibold text-white" type="button" data-period="7">7 dage</button>
                        <button class="dashboard-period min-h-9 rounded-md px-3 text-sm font-semibold text-[#54605a] transition hover:bg-[#edf1ed]" type="button" data-period="30">30 dage</button>
                        <button class="dashboard-period min-h-9 rounded-md px-3 text-sm font-semibold text-[#54605a] transition hover:bg-[#edf1ed]" type="button" data-period="90">90 dage</button>
                    </div>
                    <p class="text-xs text-[#637069]">Senest opdateret 29. jul. 2026, 16:22</p>
                </div>
            </div>

            <section class="py-6" aria-labelledby="overview-heading">
                <div class="mb-4 flex items-baseline justify-between gap-4">
                    <h2 id="overview-heading" class="text-base font-semibold text-[#17201d]">Overblik</h2>
                    <p class="text-xs text-[#637069]" data-period-label>Seneste 7 dage</p>
                </div>
                <dl class="grid gap-px overflow-hidden rounded-xl border border-[#dce1dc] bg-[#dce1dc] sm:grid-cols-2 xl:grid-cols-4">
                    <div class="bg-[#fbfcfa] p-5">
                        <dt class="text-sm text-[#637069]">Estimeret lagerafgang</dt>
                        <dd class="mt-3 flex items-end justify-between gap-3"><span class="text-3xl font-semibold tracking-[-0.04em]" data-period-value="afgang">62</span><span class="mb-1 text-sm font-semibold text-[#23704d]" data-period-change="afgang">4,1 %</span></dd>
                        <p class="mt-2 text-xs text-[#637069]">Enheder med fald i beholdning</p>
                    </div>
                    <div class="bg-[#fbfcfa] p-5">
                        <dt class="text-sm text-[#637069]">Aktuelt lager</dt>
                        <dd class="mt-3 flex items-end justify-between gap-3"><span class="text-3xl font-semibold tracking-[-0.04em]" data-period-value="lager">1.511</span><span class="mb-1 text-sm font-semibold text-[#9b4b2c]" data-period-change="lager">−62</span></dd>
                        <p class="mt-2 text-xs text-[#637069]">På tværs af Aarhus-butikker</p>
                    </div>
                    <div class="bg-[#fbfcfa] p-5">
                        <dt class="text-sm text-[#637069]">Lager på udsalg</dt>
                        <dd class="mt-3"><span class="text-3xl font-semibold tracking-[-0.04em]" data-period-value="udsalg">38 %</span></dd>
                        <p class="mt-2 text-xs text-[#637069]">Gns. rabat på udsalgsvarer: 27 %</p>
                    </div>
                    <div class="bg-[#fbfcfa] p-5">
                        <dt class="text-sm text-[#637069]">Udsolgte størrelser</dt>
                        <dd class="mt-3 flex items-end justify-between gap-3"><span class="text-3xl font-semibold tracking-[-0.04em]" data-period-value="udsolgt">19 %</span><span class="mb-1 text-sm font-semibold text-[#9b4b2c]" data-period-change="udsolgt">+2,3 pp</span></dd>
                        <p class="mt-2 text-xs text-[#637069]">Andel af observerede størrelser</p>
                    </div>
                </dl>
                <p class="mt-3 text-xs leading-5 text-[#637069]">Lagerafgang er et estimat baseret på observerede beholdningsfald og kan inkludere korrektioner eller interne flytninger.</p>
            </section>

            <div class="grid gap-6 lg:grid-cols-[minmax(0,1.45fr)_minmax(280px,.8fr)]">
                <section class="rounded-xl border border-[#dce1dc] bg-[#fbfcfa]" aria-labelledby="movement-heading">
                    <div class="flex items-start justify-between gap-4 border-b border-[#dce1dc] px-5 py-5">
                        <div><h2 id="movement-heading" class="font-semibold">Mest bevægelse</h2><p class="mt-1 text-sm text-[#637069]">Produkter med størst estimeret lagerafgang</p></div>
                        <button class="min-h-10 shrink-0 rounded-lg border border-[#cbd3cc] px-3 text-sm font-semibold text-[#2b3931] transition hover:bg-[#edf1ed]" type="button">Se alle</button>
                    </div>
                    <div class="divide-y divide-[#e2e6e2]">
                        {movement.map((item, index) => (
                            <article class="grid grid-cols-[2rem_minmax(0,1fr)_auto] items-center gap-3 px-5 py-4">
                                <span class="text-sm font-semibold text-[#829087]">{index + 1}</span>
                                <div class="min-w-0"><h3 class="truncate text-sm font-semibold text-[#17201d]">{item.product}</h3><p class="mt-1 truncate text-xs text-[#637069]">{item.category} · {item.store}</p></div>
                                <div class="text-right"><p class="text-sm font-semibold text-[#9b4b2c]">{item.change}</p><p class="mt-1 text-xs text-[#637069]">{item.pace}</p></div>
                            </article>
                        ))}
                    </div>
                </section>

                <section class="rounded-xl border border-[#dce1dc] bg-[#fbfcfa] p-5" aria-labelledby="store-heading">
                    <h2 id="store-heading" class="font-semibold">Lager pr. butik</h2>
                    <p class="mt-1 text-sm text-[#637069]">Aktuel beholdning og ændring</p>
                    <ul class="mt-7 space-y-6">
                        {stockByStore.map((store) => (
                            <li>
                                <div class="flex items-baseline justify-between gap-3"><span class="text-sm font-semibold">{store.name}</span><span class="text-sm font-semibold">{store.stock.toLocaleString("da-DK")}</span></div>
                                <div class="mt-2 h-2 overflow-hidden rounded-full bg-[#e7ebe7]"><div class="h-full rounded-full bg-[#476d58]" style={`width: ${store.share}%`}></div></div>
                                <p class="mt-2 text-xs text-[#637069]"><span class="font-semibold text-[#9b4b2c]">{store.change} stk.</span> i perioden · {store.share} % af lageret</p>
                            </li>
                        ))}
                    </ul>
                </section>
            </div>

            <section class="mt-6 rounded-xl border border-[#dce1dc] bg-[#fbfcfa]" aria-labelledby="price-heading">
                <div class="flex flex-col gap-3 border-b border-[#dce1dc] px-5 py-5 sm:flex-row sm:items-end sm:justify-between">
                    <div><h2 id="price-heading" class="font-semibold">Pris og lagertryk</h2><p class="mt-1 text-sm text-[#637069]">Hvor rabatter og beholdning peger på en mulig indsats</p></div>
                    <span class="inline-flex w-fit rounded-full bg-[#f7eadf] px-3 py-1 text-xs font-semibold text-[#754122]">16 produkter kræver opmærksomhed</span>
                </div>
                <div class="grid divide-y divide-[#e2e6e2] sm:grid-cols-3 sm:divide-x sm:divide-y-0">
                    <div class="p-5"><p class="text-sm font-semibold">Højt lager · lav afgang</p><p class="mt-2 text-sm leading-6 text-[#637069]">11 produkter har haft under 2 enheders estimeret afgang trods mere end 20 enheder på lager.</p><button class="mt-4 text-sm font-semibold text-[#275a42] hover:underline" type="button">Gennemgå produkter</button></div>
                    <div class="p-5"><p class="text-sm font-semibold">Efter prisnedsættelse</p><p class="mt-2 text-sm leading-6 text-[#637069]">Afgangen er 1,8× højere for varer med mindst 25 % rabat i den seneste periode.</p><button class="mt-4 text-sm font-semibold text-[#275a42] hover:underline" type="button">Se priseffekt</button></div>
                    <div class="p-5"><p class="text-sm font-semibold">Størrelser med risiko</p><p class="mt-2 text-sm leading-6 text-[#637069]">M og L er oftest udsolgt på tværs af de produkter, der bevæger sig hurtigst.</p><button class="mt-4 text-sm font-semibold text-[#275a42] hover:underline" type="button">Se størrelsesbillede</button></div>
                </div>
            </section>
        </main>

        <script>
            const periods = {
                7: { label: "Seneste 7 dage", afgang: "62", afgangChange: "4,1 %", lager: "1.511", lagerChange: "−62", udsalg: "38 %", udsolgt: "19 %", udsolgtChange: "+2,3 pp" },
                30: { label: "Seneste 30 dage", afgang: "214", afgangChange: "14,2 %", lager: "1.511", lagerChange: "−214", udsalg: "38 %", udsolgt: "23 %", udsolgtChange: "+6,1 pp" },
                90: { label: "Seneste 90 dage", afgang: "508", afgangChange: "33,6 %", lager: "1.511", lagerChange: "−508", udsalg: "38 %", udsolgt: "27 %", udsolgtChange: "+10,4 pp" },
            };
            document.querySelectorAll(".dashboard-period").forEach((button) => {
                button.addEventListener("click", () => {
                    const period = periods[button.dataset.period];
                    if (!period) return;
                    document.querySelectorAll(".dashboard-period").forEach((item) => { item.className = "dashboard-period min-h-9 rounded-md px-3 text-sm font-semibold text-[#54605a] transition hover:bg-[#edf1ed]"; });
                    button.className = "dashboard-period min-h-9 rounded-md bg-[#253b30] px-3 text-sm font-semibold text-white";
                    document.querySelector("[data-period-label]").textContent = period.label;
                    document.querySelector('[data-period-value="afgang"]').textContent = period.afgang;
                    document.querySelector('[data-period-change="afgang"]').textContent = period.afgangChange;
                    document.querySelector('[data-period-value="lager"]').textContent = period.lager;
                    document.querySelector('[data-period-change="lager"]').textContent = period.lagerChange;
                    document.querySelector('[data-period-value="udsalg"]').textContent = period.udsalg;
                    document.querySelector('[data-period-value="udsolgt"]').textContent = period.udsolgt;
                    document.querySelector('[data-period-change="udsolgt"]').textContent = period.udsolgtChange;
                });
            });
        </script>
    </body>
</html>
