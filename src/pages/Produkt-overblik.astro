---
import ProductLoadMore from "../components/ProductLoadMore.astro";
import SearchSection from "../components/SearchSection.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const defaultZoom = 3;
---

<SiteLayout
    title="Produkter fra lokale butikker"
    description="Søg efter tøj, brands og butikker fra lokale modebutikker i Aarhus."
>
    <div
        class="mx-auto max-w-5xl"
        id="product-overview"
        data-zoom={String(defaultZoom)}
        data-default-zoom={String(defaultZoom)}
    >
        <SearchSection
            action="/Produkt-overblik"
            compact={true}
            placeholder="Søg efter brands, produkter eller butikker"
        />

        <section class="pb-12 pt-2 md:pb-16">
            <div class="mb-5 flex items-end justify-between gap-4">
                <div>
                    <h1
                        class="text-[1.9rem] font-semibold tracking-[-0.03em] text-[#1e1a17] md:text-[2.3rem]"
                    >
                        Produkt overblik
                    </h1>
                    <p
                        class="mt-1 text-sm text-[#6e645d] md:text-base"
                        data-results-copy
                    >
                        Henter produkter...
                    </p>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-[#6e645d]">
                        Udforsk produkter fra mindre lokale modebutikker i
                        Aarhus. Brug søgning og zoom til hurtigt at skifte
                        mellem overblik og detaljer.
                    </p>
                </div>
            </div>

            <noscript>
                <div
                    class="mb-6 rounded-[1.25rem] border border-black/10 bg-white px-5 py-4 text-sm leading-6 text-[#5c534b]"
                >
                    Produkterne hentes dynamisk. Slå JavaScript til for at se
                    det aktuelle produktudvalg.
                </div>
            </noscript>

            <div class="p-1 md:p-2">
                <div class="zoom-bar-sticky mb-6">
                    <div class="zoom-bar-inner">
                        <div class="mb-3">
                            <h2
                                class="text-[1.55rem] font-semibold tracking-[-0.03em] text-[#1e1a17]"
                                data-zoom-label
                            >
                                Zoom niveau {defaultZoom} af 4
                            </h2>
                        </div>

                        <input
                            class="zoom-slider h-2 w-full cursor-pointer appearance-none rounded-full bg-[#e8e5e1]"
                            type="range"
                            min="1"
                            max="4"
                            step="1"
                            value={String(defaultZoom)}
                            aria-label="Vælg zoom niveau"
                            data-zoom-slider
                        />
                    </div>
                </div>

                <div
                    class="rounded-[1.5rem] border border-dashed border-black/10 bg-[#f7f2ea] px-6 py-14 text-center"
                    data-loading-state
                >
                    <p class="text-lg font-medium text-[#3e3530]">
                        Henter produkter...
                    </p>
                </div>

                <div
                    class="rounded-[1.5rem] border border-dashed border-black/10 bg-[#f7f2ea] px-6 py-14 text-center"
                    data-empty-state
                    hidden
                >
                    <p class="text-lg font-medium text-[#3e3530]">
                        Vi kunne ikke finde nogle produkter.
                    </p>
                    <p class="mt-2 text-sm text-[#6e645d]">
                        Prøv med et andet søgeord eller fjern din filtrering.
                    </p>
                </div>

                <div
                    class="rounded-[1.5rem] border border-dashed border-black/10 bg-[#f7f2ea] px-6 py-14 text-center"
                    data-error-state
                    hidden
                >
                    <p class="text-lg font-medium text-[#3e3530]">
                        Der opstod en fejl ved hentning af produkter.
                    </p>
                    <p class="mt-2 text-sm text-[#6e645d]">
                        Prøv igen om et øjeblik.
                    </p>
                </div>

                <div class="product-grid grid gap-4" data-product-grid hidden>
                </div>

                <ProductLoadMore />
            </div>
        </section>
    </div>

    <script>
        import {
            applyProductSearch,
            getProductHref,
            mapOverviewProduct,
            productSources,
        } from "../lib/productSources.js";
        import {
            applyProductFilters,
            applyProductSort,
            getProductSourcesForFilters,
            parseProductFilters,
        } from "../lib/productFilters.js";
        import {
            captureAnalyticsEvent,
            getProductAnalyticsProperties,
        } from "../lib/analytics.js";
        import { supabase } from "../lib/supabaseClient.js";

        const overview = document.getElementById("product-overview");
        const defaultZoom = Number(overview?.dataset.defaultZoom ?? "3");
        const zoomStorageKey = "highlide-product-overview-zoom";

        if (!overview) {
            console.error("Missing product overview root element.");
        }

        const searchInput = document.getElementById("frontpage-search");
        const searchForm = searchInput?.closest("form");
        const slider = overview?.querySelector("[data-zoom-slider]");
        const zoomLabel = overview?.querySelector("[data-zoom-label]");
        const resultsCopy = overview?.querySelector("[data-results-copy]");
        const grid = overview?.querySelector("[data-product-grid]");
        const loadingState = overview?.querySelector("[data-loading-state]");
        const emptyState = overview?.querySelector("[data-empty-state]");
        const errorState = overview?.querySelector("[data-error-state]");
        const loadMoreWrap = overview?.querySelector("[data-load-more-wrap]");
        const loadMoreCopy = overview?.querySelector("[data-load-more-copy]");
        const loadMoreProgress = overview?.querySelector(
            "[data-load-more-progress]",
        );
        const loadMoreButton = overview?.querySelector("[data-load-more]");
        const siteHeader = document.querySelector("header");

        const fallbackImage = "/images/clothes/Brown_coat.png";
        const url = new URL(window.location.href);
        const searchQuery = (url.searchParams.get("q") ?? "").trim();
        const activeFilters = parseProductFilters(url.searchParams);
        const activeSources = getProductSourcesForFilters(
            productSources,
            activeFilters,
        );
        const storedZoom =
            window.localStorage.getItem(zoomStorageKey) ?? String(defaultZoom);
        let currentZoom = Math.min(
            4,
            Math.max(
                1,
                Number.parseInt(
                    url.searchParams.get("zoom") ?? storedZoom,
                    10,
                ) || defaultZoom,
            ),
        );

        if (searchInput) {
            searchInput.value = searchQuery;
        }

        let zoomInput = searchForm?.querySelector('input[name="zoom"]');
        if (searchForm && !zoomInput) {
            zoomInput = document.createElement("input");
            zoomInput.type = "hidden";
            zoomInput.name = "zoom";
            searchForm.append(zoomInput);
        }

        let cards = [];
        let loadedCount = 0;
        let totalCount = 0;
        let isFetching = false;
        let hasCapturedSearch = false;
        let latestSearchResults = null;
        let sourceState = new Map();
        const zoomConfig = {
            1: { label: "Zoom niveau 1 af 4", pageSize: 50 },
            2: { label: "Zoom niveau 2 af 4", pageSize: 24 },
            3: { label: "Zoom niveau 3 af 4", pageSize: 12 },
            4: { label: "Zoom niveau 4 af 4", pageSize: 6 },
        };

        const formatPrice = (value) => {
            const numberValue =
                typeof value === "number" ? value : Number.parseFloat(value);

            if (!Number.isFinite(numberValue)) {
                return value ? String(value) : "Pris ikke angivet";
            }

            const formattedPrice = new Intl.NumberFormat("da-DK", {
                maximumFractionDigits: Number.isInteger(numberValue) ? 0 : 2,
            }).format(numberValue);

            return Number.isInteger(numberValue)
                ? `${formattedPrice},-`
                : formattedPrice;
        };

        const getPriceNumber = (value) => {
            if (value == null || value === "") return null;

            const numberValue =
                typeof value === "number" ? value : Number.parseFloat(value);

            return Number.isFinite(numberValue) ? numberValue : null;
        };

        const getDiscountPercent = (currentPrice, listPrice) => {
            if (!currentPrice || !listPrice || listPrice <= currentPrice) {
                return null;
            }

            const discount = Math.round(
                ((listPrice - currentPrice) / listPrice) * 100,
            );

            return discount > 0 ? discount : null;
        };

        const mapProduct = (product, source) => {
            const mappedProduct = mapOverviewProduct(
                product,
                source,
                fallbackImage,
            );

            return {
                ...mappedProduct,
                priceValue: mappedProduct.price,
                price: formatPrice(mappedProduct.price, mappedProduct.currency),
                listPriceValue: mappedProduct.listPrice,
                listPrice: formatPrice(
                    mappedProduct.listPrice,
                    mappedProduct.currency,
                ),
            };
        };

        const createProductCard = (product, resultPosition) => {
            const link = document.createElement("a");
            link.href = getProductHref(product);
            link.className =
                "product-card block rounded-[1.05rem] border border-transparent text-[#1e1a17] transition";
            link.dataset.productCard = "";
            link.dataset.productId = String(product.id);
            link.addEventListener("click", () => {
                const eventProperties = {
                    ...getProductAnalyticsProperties(product),
                    surface: "catalogue",
                    search_query: searchQuery || null,
                    result_position: resultPosition,
                    result_count: totalCount,
                };

                captureAnalyticsEvent("product_clicked", eventProperties);
                if (searchQuery) {
                    captureAnalyticsEvent(
                        "search_result_clicked",
                        eventProperties,
                    );
                }
            });
            link.setAttribute(
                "aria-label",
                `Se detaljer for ${product.brand} ${product.name}`,
            );

            const imageWrap = document.createElement("div");
            imageWrap.className =
                "product-image-wrap relative aspect-[0.78] overflow-hidden rounded-[0.9rem]";

            const image = document.createElement("img");
            image.src = product.image;
            image.alt = `${product.brand} ${product.name}`;
            image.loading = "lazy";
            image.className =
                "product-image h-full w-full object-contain object-center";

            imageWrap.append(image);

            const meta = document.createElement("div");
            meta.className =
                "product-meta grid content-start px-1 pt-3";

            const store = document.createElement("p");
            store.className =
                "store truncate text-xs font-semibold uppercase tracking-[0.08em] text-[#4d1515]";
            store.textContent = product.store;

            const brand = document.createElement("p");
            brand.className =
                "brand truncate text-xs font-semibold uppercase tracking-[0.08em] text-[#84786d]";
            brand.textContent = product.brand;

            const name = document.createElement("p");
            name.className = "name text-base font-medium text-[#2f2a26]";
            name.textContent = product.name;

            const currentPriceNumber = getPriceNumber(product.priceValue);
            const listPriceNumber = getPriceNumber(product.listPriceValue);
            const isOnSale =
                currentPriceNumber != null &&
                listPriceNumber != null &&
                listPriceNumber > currentPriceNumber;
            const discountPercent = getDiscountPercent(
                currentPriceNumber,
                listPriceNumber,
            );

            const priceRow = document.createElement("div");
            priceRow.className =
                "price-row flex min-w-0 flex-wrap items-baseline gap-x-1.5 gap-y-0";

            const price = document.createElement("p");
            price.className = `price text-[1.05rem] font-semibold ${
                isOnSale ? "text-[#7a1717]" : "text-[#171411]"
            }`;
            price.textContent = product.price;

            priceRow.append(price);

            if (isOnSale) {
                const listPrice = document.createElement("p");
                listPrice.className =
                    "list-price truncate text-sm font-medium text-[#8a8178] line-through";
                listPrice.textContent = product.listPrice;

                const desktopSaleBadge = document.createElement("span");
                desktopSaleBadge.className =
                    "desktop-sale-badge rounded-full bg-[#420e0e] px-1.5 py-0.5 text-[0.65rem] font-semibold uppercase leading-4 text-white";
                desktopSaleBadge.textContent = "Udsalg";

                priceRow.append(listPrice, desktopSaleBadge);

                const saleBadge = document.createElement("span");
                saleBadge.className =
                    "sale-badge absolute left-2 top-2 rounded-full bg-[#420e0e] px-2 py-1 text-[0.65rem] font-semibold leading-none text-white shadow-[0_2px_8px_rgba(66,14,14,0.18)]";
                saleBadge.textContent = discountPercent
                    ? `-${discountPercent}%`
                    : "Tilbud";
                imageWrap.append(saleBadge);
            }

            const details = document.createElement("p");
            details.className =
                "details text-sm text-[#6e645d]";
            const stockCopy =
                product.stock == null
                    ? "På lager i Aarhus"
                    : `${product.stock} på lager i Aarhus`;
            details.textContent = `${product.detail} · ${stockCopy}`;

            meta.append(store, brand, name, priceRow, details);
            link.append(imageWrap, meta);

            return link;
        };

        const findScrollAnchor = () => {
            const viewportTarget = Math.min(window.innerHeight * 0.35, 260);

            return cards.reduce((closest, card) => {
                const rect = card.getBoundingClientRect();
                if (rect.bottom <= 0 || rect.top >= window.innerHeight) {
                    return closest;
                }

                const distance = Math.abs(rect.top - viewportTarget);
                if (!closest || distance < closest.distance) {
                    return { card, distance };
                }

                return closest;
            }, null)?.card;
        };

        const preserveScrollDuring = (callback) => {
            const anchor = findScrollAnchor();
            const previousTop = anchor?.getBoundingClientRect().top;

            callback();

            if (!anchor || typeof previousTop !== "number") return;

            window.requestAnimationFrame(() => {
                const nextTop = anchor.getBoundingClientRect().top;
                window.scrollBy({
                    top: nextTop - previousTop,
                    left: 0,
                    behavior: "auto",
                });
            });
        };

        const updateGrid = (updateHistory = true) => {
            if (!overview || !slider || !zoomLabel) return;

            const zoom = Number(slider.value);
            const config = zoomConfig[zoom] ?? zoomConfig[2];
            currentZoom = zoom;
            overview.dataset.zoom = String(zoom);
            zoomLabel.textContent = config.label;
            if (zoomInput) {
                zoomInput.value = String(zoom);
            }

            window.localStorage.setItem(zoomStorageKey, String(zoom));

            if (updateHistory) {
                const nextUrl = new URL(window.location.href);
                nextUrl.searchParams.set("zoom", String(zoom));
                nextUrl.searchParams.delete("page");
                window.history.replaceState({}, "", nextUrl);
            }

            cards.forEach((card) => {
                card.hidden = false;
            });
        };

        const updateResultsCopy = (count, query) => {
            if (!resultsCopy) return;

            if (count > 0) {
                resultsCopy.textContent = `${count} resultater${query ? ` for “${query}”` : ""}`;
                return;
            }

            resultsCopy.textContent = `Ingen resultater${query ? ` for “${query}”` : ""}`;
        };

        const updateLoadMoreState = () => {
            if (!loadMoreWrap || !loadMoreCopy || !loadMoreProgress) return;

            if (totalCount <= 0) {
                loadMoreWrap.hidden = true;
                return;
            }

            const visibleCount = Math.min(loadedCount, totalCount);
            const progress = Math.min(100, (visibleCount / totalCount) * 100);
            loadMoreCopy.textContent = `Viser ${visibleCount} af ${totalCount} produkter`;
            loadMoreProgress.style.width = `${progress}%`;
            loadMoreWrap.hidden = false;

            if (loadMoreButton) {
                loadMoreButton.hidden = visibleCount >= totalCount;
                loadMoreButton.disabled = isFetching;
                loadMoreButton.textContent = isFetching
                    ? "Henter..."
                    : "Indlæs flere";
            }
        };

        const updateStickyHeaderOffset = () => {
            if (!overview || !siteHeader) return;

            overview.style.setProperty(
                "--site-header-offset",
                `${Math.round(siteHeader.getBoundingClientRect().height)}px`,
            );
        };

        const setState = ({
            loading = false,
            empty = false,
            error = false,
            gridVisible = false,
        }) => {
            loadingState?.toggleAttribute("hidden", !loading);
            emptyState?.toggleAttribute("hidden", !empty);
            errorState?.toggleAttribute("hidden", !error);
            grid?.toggleAttribute("hidden", !gridVisible);
            if (error) {
                loadMoreWrap?.toggleAttribute("hidden", true);
            }
        };

        const fetchSourceBatch = async (source, amount) => {
            const state = sourceState.get(source.key) ?? {
                loaded: 0,
                total: null,
                buffer: [],
            };
            const from = state.loaded;
            const to = from + amount - 1;

            let query = supabase
                .from(source.table)
                .select(source.overviewSelect, { count: "exact" })
                .range(from, to);

            query = source.applyAvailableFilter(query);
            query = applyProductFilters(query, activeFilters);
            query = applyProductSort(query, activeFilters.sort);

            if (searchQuery) {
                query = applyProductSearch(query, source, searchQuery);
            }

            const { data, error, count } = await query;

            if (error) throw error;

            const products = (data ?? []).map((product) =>
                mapProduct(product, source),
            );
            sourceState.set(source.key, {
                ...state,
                loaded: state.loaded + (data?.length ?? 0),
                total: count ?? state.loaded + (data?.length ?? 0),
            });

            return products;
        };

        const compareNullableNumbers = (left, right, direction) => {
            const leftNumber = getPriceNumber(left);
            const rightNumber = getPriceNumber(right);

            if (leftNumber == null && rightNumber == null) return 0;
            if (leftNumber == null) return 1;
            if (rightNumber == null) return -1;

            return (leftNumber - rightNumber) * direction;
        };

        const compareText = (left, right) =>
            String(left ?? "").localeCompare(String(right ?? ""), "da", {
                numeric: true,
                sensitivity: "base",
            });

        const compareProductsForSort = (left, right) => {
            let comparison = 0;

            if (activeFilters.sort === "price-asc") {
                comparison = compareNullableNumbers(
                    left.priceValue,
                    right.priceValue,
                    1,
                );
            } else if (activeFilters.sort === "price-desc") {
                comparison = compareNullableNumbers(
                    left.priceValue,
                    right.priceValue,
                    -1,
                );
            } else if (activeFilters.sort === "name-asc") {
                comparison = compareText(left.name, right.name);
            } else if (activeFilters.sort === "brand-asc") {
                comparison = compareText(left.brand, right.brand);
                if (comparison === 0) comparison = compareText(left.name, right.name);
            }

            if (comparison !== 0) return comparison;

            comparison = compareText(left.brand, right.brand);
            if (comparison !== 0) return comparison;

            comparison = compareText(left.name, right.name);
            if (comparison !== 0) return comparison;

            return compareText(`${left.sourceKey}-${left.id}`, `${right.sourceKey}-${right.id}`);
        };

        const fetchSortedPage = async (pageSize) => {
            const fillBuffer = async (source) => {
                let state = sourceState.get(source.key) ?? {
                    loaded: 0,
                    total: null,
                    buffer: [],
                };

                while (
                    state.buffer.length < pageSize &&
                    (state.total == null || state.loaded < state.total)
                ) {
                    const amount = pageSize - state.buffer.length;
                    const products = await fetchSourceBatch(source, amount);
                    state = sourceState.get(source.key);

                    if (!products.length) break;

                    state.buffer = [...state.buffer, ...products];
                    sourceState.set(source.key, state);
                }
            };

            await Promise.all(activeSources.map(fillBuffer));

            const candidates = activeSources.flatMap(
                (source) => sourceState.get(source.key)?.buffer ?? [],
            );
            const products = candidates
                .sort(compareProductsForSort)
                .slice(0, pageSize);
            const selected = new Set(products);

            activeSources.forEach((source) => {
                const state = sourceState.get(source.key);
                if (!state) return;

                sourceState.set(source.key, {
                    ...state,
                    buffer: state.buffer.filter((product) => !selected.has(product)),
                });
            });

            return products;
        };

        const captureCompletedSearch = () => {
            if (
                !searchQuery ||
                hasCapturedSearch ||
                !Array.isArray(latestSearchResults)
            ) {
                return;
            }

            hasCapturedSearch = captureAnalyticsEvent("search_performed", {
                query: searchQuery,
                result_count: totalCount,
                has_results: totalCount > 0,
                returned_product_keys: latestSearchResults
                    .map(
                        (product) =>
                            getProductAnalyticsProperties(product).product_key,
                    )
                    .filter(Boolean),
                returned_result_count: latestSearchResults.length,
            });
        };

        const fetchProducts = async ({ reset = false } = {}) => {
            if (isFetching) return;
            isFetching = true;

            if (reset) {
                loadedCount = 0;
                totalCount = 0;
                cards = [];
                sourceState = new Map();
                if (grid) grid.innerHTML = "";
                setState({ loading: true });
            } else {
                updateLoadMoreState();
            }

            const config = zoomConfig[currentZoom] ?? zoomConfig[defaultZoom];
            const pageSize = config.pageSize;
            const products = [];

            try {
                if (activeFilters.sort !== "standard") {
                    products.push(...(await fetchSortedPage(pageSize)));
                } else {
                    while (products.length < pageSize) {
                        const sourcesWithProducts = activeSources.filter((source) => {
                            const state = sourceState.get(source.key);
                            return state?.total == null || state.loaded < state.total;
                        });

                        if (sourcesWithProducts.length === 0) break;

                        const amount = Math.ceil(
                            (pageSize - products.length) / sourcesWithProducts.length,
                        );
                        const batches = await Promise.all(
                            sourcesWithProducts.map((source) =>
                                fetchSourceBatch(source, amount),
                            ),
                        );
                        const fetched = batches.flat();
                        products.push(...fetched);

                        if (fetched.length === 0) break;
                    }
                }
            } catch (error) {
                console.error(error);
                updateResultsCopy(0, searchQuery);
                setState({ error: true });
                isFetching = false;
                updateLoadMoreState();
                return;
            }

            totalCount = [...sourceState.values()].reduce(
                (total, state) => total + (state.total ?? 0),
                0,
            );
            const firstResultPosition = loadedCount + 1;
            loadedCount += products.length;

            updateResultsCopy(totalCount, searchQuery);

            if (reset) {
                latestSearchResults = products;
                captureCompletedSearch();
            }

            if (!grid) {
                isFetching = false;
                updateLoadMoreState();
                return;
            }

            products.forEach((product, index) =>
                grid.append(
                    createProductCard(product, firstResultPosition + index),
                ),
            );

            cards = [...grid.querySelectorAll("[data-product-card]")];

            if (products.length === 0) {
                setState({ empty: true });
                isFetching = false;
                updateLoadMoreState();
                return;
            }

            setState({ gridVisible: true });
            updateGrid(false);
            isFetching = false;
            updateLoadMoreState();
        };

        if (slider) {
            slider.value = String(currentZoom);
        }
        updateStickyHeaderOffset();
        window.addEventListener("resize", updateStickyHeaderOffset);
        updateGrid(false);

        slider?.addEventListener("input", () => {
            preserveScrollDuring(() => {
                updateGrid(true);
            });
        });

        if (slider) {
            const mobileZoomQuery = window.matchMedia("(max-width: 768px)");
            let activeZoomPointerId = null;

            const snapZoomToPointer = (event) => {
                if (!mobileZoomQuery.matches) return;

                const rect = slider.getBoundingClientRect();
                const ratio = Math.min(
                    1,
                    Math.max(0, (event.clientX - rect.left) / rect.width),
                );
                const nextZoom = String(Math.round(ratio * 3) + 1);

                if (slider.value === nextZoom) return;
                slider.value = nextZoom;
                preserveScrollDuring(() => {
                    updateGrid(true);
                });
            };

            slider.addEventListener("pointerdown", (event) => {
                if (!mobileZoomQuery.matches) return;

                activeZoomPointerId = event.pointerId;
                slider.setPointerCapture?.(event.pointerId);
                snapZoomToPointer(event);
            });

            slider.addEventListener("pointermove", (event) => {
                if (
                    !mobileZoomQuery.matches ||
                    activeZoomPointerId !== event.pointerId
                ) {
                    return;
                }

                snapZoomToPointer(event);
            });

            const clearActivePointer = (event) => {
                if (activeZoomPointerId !== event.pointerId) return;

                activeZoomPointerId = null;
            };

            slider.addEventListener("pointerup", clearActivePointer);
            slider.addEventListener("pointercancel", clearActivePointer);
        }

        loadMoreButton?.addEventListener("click", () => {
            fetchProducts();
        });

        fetchProducts({ reset: true });
    </script>

    <style is:global>
        .zoom-bar-sticky {
            position: sticky;
            top: var(--site-header-offset, 4.75rem);
            z-index: 10;
        }

        .zoom-bar-inner {
            background: #f8f4ec;
            padding: 0 0 0.8rem;
        }

        .zoom-slider {
            touch-action: pan-y;
        }

        .zoom-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            height: 1.6rem;
            width: 1.6rem;
            border-radius: 999px;
            background: #4e1515;
