---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
    title="Produktdetaljer"
    description="Se produktdetaljer, størrelser og butik for et lokalt modefund på HIGHLIDE."
    noindex={true}
>
    <section
        class="-mt-8 mx-auto max-w-3xl pb-10 md:-mt-8"
        id="product-detail"
    >
        <div
            class="relative left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-[#f3eee6] sm:left-auto sm:w-full sm:translate-x-0"
            data-image-stage
        >
            <button
                type="button"
                class="absolute left-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/70 text-[#1e1a17] shadow-[0_12px_30px_rgba(0,0,0,0.16)] backdrop-blur-md transition hover:scale-[1.02] hover:bg-white/82"
                aria-label="Tilbage til produktoversigt"
                data-back-button
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                    class="h-5 w-5"
                >
                    <path
                        d="M15 6 9 12l6 6"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </button>

            <div class="relative aspect-[0.82] w-full px-6 py-10 sm:px-10">
                <div
                    class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-[#6f655b]"
                    data-image-loading
                >
                    <span
                        class="h-8 w-8 animate-spin rounded-full border-2 border-[#c9beb3] border-t-[#420e0e]"
                    ></span>
                    <p class="text-sm font-medium">Henter billede...</p>
                </div>
                <img
                    alt=""
                    class="h-full w-full object-contain opacity-0 transition-opacity duration-200"
                    data-product-image
                />
            </div>

            <div
                class="absolute bottom-4 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2 rounded-full bg-white/80 px-3 py-2 shadow-[0_10px_26px_rgba(58,44,31,0.14)] backdrop-blur-md"
                data-image-dots
                hidden
            >
            </div>
        </div>

        <noscript>
            <div
                class="mt-6 rounded-[1.25rem] border border-black/10 bg-white px-5 py-4 text-sm leading-6 text-[#5c534b]"
            >
                Produktdetaljer hentes dynamisk. Slå JavaScript til for at se
                billeder, størrelser og butik.
            </div>
        </noscript>

        <div
            class="mt-6 rounded-[1.25rem] border border-black/10 bg-[#f8f4ec] px-5 py-5 text-[#3e3530]"
            data-loading-state
        >
            <p class="text-base font-semibold">Henter produkt...</p>
        </div>

        <div
            class="mt-6 rounded-[1.25rem] border border-black/10 bg-[#f8f4ec] px-5 py-5 text-[#3e3530]"
            data-error-state
            hidden
        >
            <p class="text-base font-semibold">Produktet kunne ikke findes.</p>
            <p class="mt-2 text-sm text-[#6e645d]">
                Gå tilbage til produktoversigten og vælg et andet produkt.
            </p>
        </div>

        <div class="space-y-7 px-1 pt-6 sm:px-0" data-product-content hidden>
            <div class="space-y-5">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <p
                            class="text-sm font-bold uppercase tracking-[0.08em] text-[#4d1515]"
                            data-product-brand
                        >
                        </p>
                        <h1
                            class="mt-1 text-[1.8rem] font-semibold leading-tight tracking-[-0.03em] text-[#171411] sm:text-[2.15rem]"
                            data-product-name
                        >
                        </h1>
                    </div>
                    <p
                        class="shrink-0 pt-1 text-[1.35rem] font-semibold text-[#171411] sm:text-[1.5rem]"
                        data-product-price
                    >
                    </p>
                </div>

                <div
                    class="flex flex-wrap gap-2"
                    data-product-highlights
                    hidden
                >
                </div>

                <div
                    class="rounded-xl border border-[#ded5ca] bg-[#f1ebe3] px-4 py-3 text-[#2f2a26]"
                >
                    <div class="flex items-center gap-3">
                        <span
                            class="h-2.5 w-2.5 shrink-0 rounded-full bg-[#258f4a]"
                            aria-hidden="true"
                        ></span>
                        <p
                            class="text-sm font-medium sm:text-base"
                            data-product-stock
                        >
                        </p>
                    </div>
                </div>
            </div>

            <a
                class="hidden w-full items-center justify-center rounded-full bg-[#420e0e] px-6 py-4 text-sm font-semibold text-white transition hover:bg-[#551515] focus:outline-none focus:ring-2 focus:ring-[#420e0e] focus:ring-offset-2 focus:ring-offset-[#f8f4ec] active:scale-[0.99]"
                href="#"
                target="_blank"
                rel="noreferrer"
                data-product-url
            >
                Se produkt hos butik
            </a>

            <section class="border-t border-black/10 pt-7">
                <div class="flex items-end justify-between gap-4">
                    <div>
                        <h2
                            class="text-base font-semibold tracking-[-0.01em] text-[#171411]"
                        >
                            Lager i Aarhus
                        </h2>
                        <p class="mt-1 text-sm leading-6 text-[#6e645d]">
                            Størrelserne herunder er dem, der er på lager i de
                            enkelte butikker.
                        </p>
                    </div>
                    <p
                        class="shrink-0 text-sm font-medium text-[#6e645d]"
                        data-product-stock-total
                    >
                    </p>
                </div>

                <div class="mt-5 grid gap-3" data-product-store-stock></div>
            </section>

            <section class="border-t border-black/10 pt-7">
                <h2
                    class="text-base font-semibold tracking-[-0.01em] text-[#171411]"
                >
                    Produktinformation
                </h2>

                <div class="mt-5" data-product-extra></div>
            </section>
        </div>
    </section>

    <script>
        import {
            getProductSource,
            getProductUrl,
            normalizeDetailProduct,
        } from "../lib/productSources.js";
        import { supabase } from "../lib/supabaseClient.js";

        const detail = document.getElementById("product-detail");

        if (!detail) {
            console.error("Missing product detail root element.");
        }

        const fallbackImage = "/images/clothes/Brown_coat.png";
        const technicalKeys = new Set([
            "id",
            "navn",
            "name",
            "brand",
            "pris",
            "price",
            "store",
            "images",
            "image",
            "sourceKey",
            "sourceName",
            "aarhus_available",
            "aarhus_total_stock",
            "aarhusTotalStock",
            "aarhus_inventory",
            "aarhusInventory",
            "local_inventory",
            "local_total_stock",
            "local_available",
            "webshop_sizes",
            "current_price",
            "list_price",
            "currency",
            "canonical_url",
            "source_url",
            "source_parent_id",
            "source_color_id",
            "source_product_number",
        ]);
        const omittedExtraKeys = new Set([
            "fts",
            "search_target",
            "embedding",
            "embeddings",
            "vector",
            "vectors",
            "raw",
        ]);
        const sizeKeys = [
            "sizes",
            "size",
            "available_sizes",
            "availableSizes",
            "storrelser",
            "størrelser",
            "tilgaengelige_storrelser",
            "tilgængelige_størrelser",
        ];
        const labelMap = {
            category: "Kategori",
            color: "Farve",
            colour: "Farve",
            description: "Beskrivelse",
            gender: "Køn",
            material: "Materiale",
            materials: "Materialer",
            product_url: "Produktlink",
            scraped_at: "Hentet",
            url: "Produktlink",
            created_at: "Oprettet",
            updated_at: "Opdateret",
            first_seen_at: "Først set",
            color_group: "Farvegruppe",
            fit: "Pasform",
        };

        const backButton = detail?.querySelector("[data-back-button]");
        const imageStage = detail?.querySelector("[data-image-stage]");
        const image = detail?.querySelector("[data-product-image]");
        const imageLoading = detail?.querySelector("[data-image-loading]");
        const imageDots = detail?.querySelector("[data-image-dots]");
        const brand = detail?.querySelector("[data-product-brand]");
        const name = detail?.querySelector("[data-product-name]");
        const price = detail?.querySelector("[data-product-price]");
        const stock = detail?.querySelector("[data-product-stock]");
        const stockTotal = detail?.querySelector("[data-product-stock-total]");
        const highlights = detail?.querySelector("[data-product-highlights]");
        const productUrl = detail?.querySelector("[data-product-url]");
        const storeStock = detail?.querySelector("[data-product-store-stock]");
        const extra = detail?.querySelector("[data-product-extra]");
        const loadingState = detail?.querySelector("[data-loading-state]");
        const errorState = detail?.querySelector("[data-error-state]");
        const content = detail?.querySelector("[data-product-content]");
        let currentImages = [fallbackImage];
        let currentImageIndex = 0;
        let touchStartX = 0;

        const isEmptyValue = (value) => {
            if (value == null) return true;
            if (typeof value === "string") return value.trim() === "";
            if (Array.isArray(value)) return value.length === 0;
            if (typeof value === "object")
                return Object.keys(value).length === 0;
            return false;
        };

        const formatLabel = (key) =>
            labelMap[key] ??
            key
                .replace(/([A-Z])/g, " $1")
                .replace(/[_-]+/g, " ")
                .trim()
                .replace(/^./, (char) => char.toUpperCase());

        const formatPrice = (value, currency = "DKK") => {
            const numberValue =
                typeof value === "number" ? value : Number.parseFloat(value);

            if (Number.isFinite(numberValue)) {
                return `${new Intl.NumberFormat("da-DK").format(numberValue)} ${currency}`;
            }

            return value ? String(value) : "Pris ikke angivet";
        };

        const formatValue = (value) => {
            if (value == null) return "";
            if (Array.isArray(value)) return value.map(formatValue).join(", ");
            if (typeof value === "object") {
                return Object.entries(value)
                    .filter(([, entryValue]) => !isEmptyValue(entryValue))
                    .map(
                        ([entryKey, entryValue]) =>
                            `${formatLabel(entryKey)}: ${formatValue(entryValue)}`,
                    )
                    .join("\n");
            }

            return String(value);
        };

        const getProductName = (product) =>
            product.navn || product.name || "Produkt";

        const getProductImages = (product) => {
            const images = [];

            if (Array.isArray(product.images)) {
                images.push(
                    ...product.images.filter(
                        (item) => typeof item === "string" && item.trim(),
                    ),
                );
            }

            if (typeof product.image === "string" && product.image.trim()) {
                images.push(product.image);
            }

            return [...new Set(images)].length > 0
                ? [...new Set(images)]
                : [fallbackImage];
        };

        const renderCurrentImage = () => {
            if (!image) return;

            image.classList.add("opacity-0");
            imageLoading?.toggleAttribute("hidden", false);
            image.src = currentImages[currentImageIndex] ?? fallbackImage;
        };

        const renderImageDots = () => {
            if (!imageDots) return;

            imageDots.innerHTML = "";
            imageDots.hidden = currentImages.length <= 1;

            currentImages.forEach((_, index) => {
                const dot = document.createElement("button");
                dot.type = "button";
                dot.className =
                    index === currentImageIndex
                        ? "h-2.5 w-5 rounded-full bg-[#420e0e] transition-all"
                        : "h-2.5 w-2.5 rounded-full bg-[#b9afa5] transition-all";
                dot.setAttribute("aria-label", `Vis billede ${index + 1}`);
                dot.addEventListener("click", () => {
                    currentImageIndex = index;
                    renderCurrentImage();
                    renderImageDots();
                });
                imageDots.append(dot);
            });
        };

        const showImage = (direction) => {
            if (currentImages.length <= 1) return;

            currentImageIndex =
                (currentImageIndex + direction + currentImages.length) %
                currentImages.length;
            renderCurrentImage();
            renderImageDots();
        };

        const formatStockCount = (stockCount) => {
            if (!Number.isFinite(stockCount)) return "Lager ukendt";
            if (stockCount === 0) return "Ikke på lager";
            if (stockCount === 1) return "1 stk. på lager";

            return `${stockCount} stk. på lager`;
        };

        const getStoreSizes = (store) => {
            const sizesByStore = store?.sizes;
            if (!sizesByStore || typeof sizesByStore !== "object") return [];

            return Object.entries(sizesByStore)
                .filter(([, value]) => value?.available)
                .map(([size, value]) => ({
                    size,
                    stock: Number(value.stock ?? 0),
                }));
        };

        const renderStoreStock = (product, source) => {
            if (!storeStock) return;

            const stores = product.aarhusInventory?.stores ?? {};
            storeStock.innerHTML = "";

            Object.entries(source.storeLabels).forEach(([storeKey, label]) => {
                const store = stores[storeKey] ?? {};
                const totalStock = Number(store.total_stock ?? 0);
                const isAvailable =
                    Boolean(store.available) || totalStock > 0;
                const availableSizes = getStoreSizes(store);

                const row = document.createElement("div");
                row.className =
                    "rounded-xl border border-[#ded5ca] bg-[#fbf8f2] px-4 py-4";

                const header = document.createElement("div");
                header.className = "flex items-start justify-between gap-4";

                const titleWrap = document.createElement("div");

                const title = document.createElement("p");
                title.className =
                    "text-base font-semibold text-[#2f2a26]";
                title.textContent = label;

                const status = document.createElement("p");
                status.className = isAvailable
                    ? "mt-1 text-sm font-medium text-[#2d7f46]"
                    : "mt-1 text-sm font-medium text-[#8a8178]";
                status.textContent = formatStockCount(totalStock);

                titleWrap.append(title, status);

                const dot = document.createElement("span");
                dot.className = isAvailable
                    ? "mt-1 h-3 w-3 shrink-0 rounded-full bg-[#2db25d]"
                    : "mt-1 h-3 w-3 shrink-0 rounded-full bg-[#c3bab1]";
                dot.setAttribute("aria-hidden", "true");

                header.append(titleWrap, dot);
                row.append(header);

                if (availableSizes.length > 0) {
                    const sizeList = document.createElement("div");
                    sizeList.className = "mt-4 flex flex-wrap gap-2";

                    availableSizes.forEach(({ size, stock: sizeStock }) => {
                        const item = document.createElement("span");
                        item.className =
                            "inline-flex min-h-9 items-center rounded-full border border-[#ded5ca] bg-[#f8f4ec] px-3 text-sm font-medium text-[#3e3530]";
                        item.textContent =
                            sizeStock > 1 ? `${size} · ${sizeStock}` : size;
                        sizeList.append(item);
                    });

                    row.append(sizeList);
                }

                storeStock.append(row);
            });
        };

        const renderHighlights = (product) => {
            if (!highlights) return;

            const items = [product.color, product.category, product.fit]
                .filter((value, index, values) =>
                    !isEmptyValue(value) && values.indexOf(value) === index,
                )
                .slice(0, 3);

            highlights.innerHTML = "";
            highlights.hidden = items.length === 0;

            items.forEach((item) => {
                const chip = document.createElement("span");
                chip.className =
                    "inline-flex min-h-8 items-center rounded-full border border-[#ded5ca] bg-[#fbf8f2] px-3 text-sm font-medium text-[#5b5149]";
                chip.textContent = item;
                highlights.append(chip);
            });
        };

        const renderExtraEntries = (product) => {
            if (!extra) return;

            const usedSizeKeys = new Set(
                sizeKeys.filter((key) => !isEmptyValue(product[key])),
            );
            const entries = Object.entries(product).filter(
                ([key, value]) =>
                    !technicalKeys.has(key) &&
                    !omittedExtraKeys.has(key) &&
                    !key.toLowerCase().includes("vector") &&
                    !usedSizeKeys.has(key) &&
                    !isEmptyValue(value),
            );

            extra.innerHTML = "";

            if (entries.length === 0) {
                const empty = document.createElement("div");
                empty.className =
                    "rounded-xl border border-dashed border-[#ded5ca] bg-[#fbf8f2] px-4 py-5 text-sm text-[#6f655b]";
                empty.textContent = "Ingen ekstra produktdata endnu.";
                extra.append(empty);
                return;
            }

            const panel = document.createElement("div");
            panel.className =
                "divide-y divide-[#ded5ca] rounded-xl border border-[#ded5ca] bg-[#fbf8f2] px-4 py-1";

            entries.forEach(([key, value]) => {
                const row = document.createElement("div");
                row.className =
                    "grid gap-2 py-4 sm:grid-cols-[9rem_1fr] sm:gap-4";

                const label = document.createElement("p");
                label.className =
                    "text-xs font-bold uppercase tracking-[0.08em] text-[#6f655b]";
                label.textContent = formatLabel(key);

                const body = document.createElement("p");
                body.className =
                    "whitespace-pre-wrap text-base leading-7 text-[#4f4741]";
                body.textContent = formatValue(value);

                row.append(label, body);
                panel.append(row);
            });

            extra.append(panel);
        };

        const setState = ({
            loading = false,
            error = false,
            visible = false,
        }) => {
            loadingState?.toggleAttribute("hidden", !loading);
            errorState?.toggleAttribute("hidden", !error);
            content?.toggleAttribute("hidden", !visible);
        };

        const renderProduct = (product) => {
            const productName = getProductName(product);
            const productBrand = product.brand || "Ukendt brand";
            const productPrice = formatPrice(
                product.pris ?? product.price,
                product.currency,
            );
            const productStore = product.store || "Ukendt butik";
            const totalAarhusStock = Number(product.aarhusTotalStock ?? 0);
            currentImages = getProductImages(product);
            currentImageIndex = 0;

            if (image) {
                image.alt = `${productBrand} ${productName}`;
            }

            renderCurrentImage();
            renderImageDots();

            if (brand) brand.textContent = productBrand;
            if (name) name.textContent = productName;
            if (price) price.textContent = productPrice;
            if (stock) {
                stock.textContent = `${formatStockCount(totalAarhusStock)} i Aarhus`;
            }
            if (stockTotal) {
                stockTotal.textContent = productStore;
            }
            if (productUrl && getProductUrl(product)) {
                productUrl.href = getProductUrl(product);
                productUrl.classList.remove("hidden");
                productUrl.classList.add("inline-flex");
            }

            document.title = `${productBrand} ${productName}`;
            renderHighlights(product);
            renderStoreStock(product, getProductSource(product.sourceKey));
            renderExtraEntries(product);
            setState({ visible: true });
        };

        const fetchProduct = async () => {
            const params = new URLSearchParams(window.location.search);
            const productId = params.get("id");
            const source = getProductSource(params.get("source"));

            if (!productId) {
                setState({ error: true });
                return;
            }

            setState({ loading: true });

            let query = supabase
                .from(source.table)
                .select(source.detailSelect)
                .eq("id", productId);

            query = source.applyAvailableFilter(query);

            const { data, error } = await query.single();

            if (error || !data) {
                console.error(error);
                setState({ error: true });
                return;
            }

            renderProduct(normalizeDetailProduct(data, source));
        };

        backButton?.addEventListener("click", () => {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }

            window.location.href = "/Produkt-overblik";
        });

        image?.addEventListener("load", () => {
            imageLoading?.toggleAttribute("hidden", true);
            image.classList.remove("opacity-0");
        });

        image?.addEventListener("error", () => {
            if (image.src.endsWith(fallbackImage)) {
                imageLoading?.toggleAttribute("hidden", true);
                image.classList.remove("opacity-0");
                return;
            }

            image.src = fallbackImage;
        });

        imageStage?.addEventListener("touchstart", (event) => {
            touchStartX = event.touches[0]?.clientX ?? 0;
        });

        imageStage?.addEventListener("touchend", (event) => {
            const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
            const deltaX = touchEndX - touchStartX;
            if (Math.abs(deltaX) < 40) return;

            showImage(deltaX < 0 ? 1 : -1);
        });

        imageStage?.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight") showImage(1);
            if (event.key === "ArrowLeft") showImage(-1);
        });

        fetchProduct();
    </script>
</SiteLayout>
