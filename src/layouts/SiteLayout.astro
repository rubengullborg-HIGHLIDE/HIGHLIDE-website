---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import PostHog from "../components/posthog.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
    title?: string;
    description?: string;
    canonicalPath?: string;
    image?: string;
    noindex?: boolean;
}

const {
    title = "HIGHLIDE",
    description = "Find tøj fra lokale modebutikker i Aarhus med HIGHLIDE.",
    canonicalPath = Astro.url.pathname,
    image = "/HIGHLIDE_logo_dark.png",
    noindex = false,
} = Astro.props;

const siteName = "HIGHLIDE";
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).toString();
const imageUrl = new URL(image, Astro.site ?? Astro.url).toString();

type NavItem = {
    href: string;
    label: string;
    icon?: string;
};

type NavSection = {
    heading?: string;
    items: NavItem[];
};

const primaryNavItems: NavItem[] = [
    { href: "/", label: "Forside", icon: "/icons/Rektangler_icon.svg" },
    {
        href: "/Produkt-overblik",
        label: "Produkter",
        icon: "/icons/Produkt_icon.svg",
    },
    {
        href: "/Butiks-info",
        label: "Butikker",
        icon: "/icons/Butik_icon.svg",
    },
];

const navSections: NavSection[] = [
    {
        heading: "Sider",
        items: primaryNavItems,
    },
    {
        heading: "Information",
        items: [
            { href: "/Om-Highlide", label: "Om HIGHLIDE" },
            { href: "/Hjaelp", label: "Hjælp" },
            { href: "/Kontakt", label: "Kontakt" },
            { href: "/Privatlivspolitik", label: "Privatlivspolitik" },
        ],
    },
];

const normalizePath = (path: string) =>
    path === "/" ? path : path.replace(/\/$/, "");
const currentPath = normalizePath(Astro.url.pathname);
const isCurrentPath = (href: string) => normalizePath(href) === currentPath;
---

<!doctype html>
<html lang="da" translate="no">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="google" content="notranslate" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex,nofollow" />}
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" type="image/png" href="/favicon.png" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={imageUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <title>{pageTitle}</title>
        <PostHog />
    </head>
    <body
        class="min-h-screen bg-[#f8f4ec] text-[#1e1a17]"
    >
        <div
            class="flex min-h-screen flex-col"
            id="site-shell"
            data-drawer-open="false"
        >
            <header
                class="sticky top-0 z-20 border-b border-black/10 bg-[#f8f4ec]/85 backdrop-blur-md"
            >
                <div
                    class="relative mx-auto flex max-w-[1120px] items-center justify-center px-4 py-4 md:px-8 lg:justify-between"
                >
                    <button
                        class:list={[
                            "absolute left-4 inline-flex h-11 w-11 shrink-0 items-center justify-center bg-transparent text-[#1e1a17] transition hover:opacity-70 md:left-8 lg:hidden",
                        ]}
                        type="button"
                        aria-label="Åbn menu"
                        aria-controls="site-drawer"
                        aria-expanded="false"
                        data-menu-button
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                            class="h-5 w-5"
                        >
                            <path
                                d="M4 7H20M4 12H20M4 17H20"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"></path>
                        </svg>
                    </button>

                    <a
                        class="inline-flex items-center"
                        href="/"
                        aria-label="HIGHLIDE forside"
                    >
                        <img
                            src="/HIGHLIDE_logo_dark.png"
                            alt="HIGHLIDE"
                            class="h-7 w-auto md:h-8"
                        />
                    </a>

                    <nav class="hidden items-stretch gap-8 self-stretch lg:flex" aria-label="Primær navigation">
                        {
                            primaryNavItems.map((item) => (
                                <a
                                    href={item.href}
                                    aria-current={isCurrentPath(item.href) ? "page" : undefined}
                                    class:list={[
                                        "relative inline-flex min-h-11 items-center text-sm font-semibold text-[#1e1a17] transition hover:text-[#420e0e] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#420e0e] focus-visible:ring-offset-4",
                                        isCurrentPath(item.href) &&
                                            "text-[#420e0e] after:absolute after:inset-x-0 after:-bottom-4 after:h-0.5 after:bg-[#420e0e]",
                                    ]}
                                >
                                    {item.label}
                                </a>
                            ))
                        }
                    </nav>
                </div>
            </header>

            <div
                class="fixed inset-0 z-30 bg-black/30 opacity-0 pointer-events-none transition-opacity duration-200"
                data-drawer-overlay
                hidden
            >
            </div>

            <aside
                class="fixed left-0 top-0 z-40 flex h-dvh w-[min(22rem,88vw)] -translate-x-full flex-col border-r border-black/10 bg-[#f8f4ec] shadow-[0_20px_50px_rgba(58,44,31,0.12)] transition-transform duration-200"
                id="site-drawer"
                aria-hidden="true"
            >
                <div
                    class="flex items-center justify-between gap-4 border-b border-black/10 px-4 py-4"
                >
                    <div class="text-sm font-bold uppercase tracking-[0.06em]">
                        Menu
                    </div>
                    <button
                        class="inline-flex h-9 w-9 items-center justify-center bg-transparent text-[#1e1a17] transition hover:opacity-70"
                        type="button"
                        aria-label="Luk menu"
                        data-drawer-close
                    >
                        <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            aria-hidden="true"
                            class="h-5 w-5"
                        >
                            <path
                                d="M6 6L18 18M18 6L6 18"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"></path>
                        </svg>
                    </button>
                </div>
                <nav class="space-y-6 px-4 py-5">
                    {
                        navSections.map((section) => (
                            <section>
                                {section.heading && (
                                    <h2 class="mb-2 text-xs font-bold uppercase tracking-[0.08em] text-[#6f655b]">
                                        {section.heading}
                                    </h2>
                                )}
                                <ul class="space-y-1">
                                    {section.items.map((item) => (
                                        <li>
                                            <a
                                                class:list={[
                                                    "flex min-h-12 w-fit items-center gap-3 rounded-full px-3 py-2 text-base transition",
                                                    isCurrentPath(item.href)
                                                        ? "bg-[#420e0e] font-semibold text-white"
                                                        : "font-medium text-[#1e1a17] hover:bg-black/5 hover:text-[#420e0e]",
                                                ]}
                                                href={item.href}
                                                aria-current={isCurrentPath(item.href) ? "page" : undefined}
                                            >
                                                {item.icon && (
                                                    <img
                                                        src={item.icon}
                                                        alt=""
                                                        aria-hidden="true"
                                                        class:list={[
                                                            "h-5 w-5 shrink-0 object-contain",
                                                            isCurrentPath(item.href) && "brightness-0 invert",
                                                        ]}
                                                    />
                                                )}
                                                <span>{item.label}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </nav>
            </aside>

            <main class="flex-1 px-4 py-8 md:px-8">
                <div class="mx-auto w-full max-w-[1120px]">
                    <slot />
                </div>
            </main>

            <Footer />
        </div>

        <AnalyticsConsent />

        <script is:inline>
            const shell = document.getElementById("site-shell");
            const menuButton = document.querySelector("[data-menu-button]");
            const drawer = document.getElementById("site-drawer");
            const overlay = document.querySelector("[data-drawer-overlay]");
            const closeButton = document.querySelector("[data-drawer-close]");

            const setDrawerOpen = (open) => {
                if (!shell || !menuButton || !drawer || !overlay) return;

                shell.dataset.drawerOpen = String(open);
                menuButton.setAttribute("aria-expanded", String(open));
                drawer.setAttribute("aria-hidden", String(!open));
                overlay.hidden = !open;

                if (open) {
                    drawer.classList.remove("-translate-x-full");
                    drawer.classList.add("translate-x-0");
                    overlay.classList.remove(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    overlay.classList.add("opacity-100", "pointer-events-auto");
                    document.body.classList.add("overflow-hidden");
                } else {
                    drawer.classList.add("-translate-x-full");
                    drawer.classList.remove("translate-x-0");
                    overlay.classList.add("opacity-0", "pointer-events-none");
                    overlay.classList.remove(
                        "opacity-100",
                        "pointer-events-auto",
                    );
                    document.body.classList.remove("overflow-hidden");
                }
            };

            menuButton?.addEventListener("click", () =>
                setDrawerOpen(shell.dataset.drawerOpen !== "true"),
            );
            closeButton?.addEventListener("click", () => setDrawerOpen(false));
            overlay?.addEventListener("click", () => setDrawerOpen(false));
            window.addEventListener("keydown", (event) => {
                if (event.key === "Escape") setDrawerOpen(false);
            });
        </script>
    </body>
</html>
